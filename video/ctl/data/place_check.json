 "lean": "import LeanFM.Session.Syntax\n\n/-- What the client orders. -/\nstructure CreateOrder where\n  item : String\n  quantity : Nat\n\n/-- The shop's price for the order, in cents. -/\nstructure Quote where\n  price : Nat\n\n/-- The client pays; the card number is a secret, never logged. -/\nstructure Pay where\n  amount : Nat\n  card_secr : String\n\nstructure Charge where\n  amount : Nat\n  card_secr : String\n\nstructure Receipt where\n  amount : Nat\n\n/-- Placing an order: quote, pay, charge the card. -/\nprotocol PlaceOrder (Client, Shop, Bank) {\n  o: CreateOrder from Client to Shop route \"POST /orders\";\n  choice {\n    q: Quote from Shop to Client cause o status 201;\n    p: Pay from Client to Shop cause q where p.amount = q.price;\n    c: Charge from Shop to Bank cause p;\n    choice {\n      d: Charged from Bank to Shop cause c;\n      Receipt from Shop to Client cause d status 200;\n    } or {\n      x: Declined from Bank to Shop cause c;\n      PaymentDeclined from Shop to Client cause x status 402;\n    }\n  } or {\n    SoldOut from Shop to Client cause o status 409;\n  }\n}\n",
 "limits": {
  "maxBranches": 16,
  "maxDepth": 24,
  "maxEvents": 600,
  "maxInstances": 200,
  "maxLoops": 8,
  "maxRoles": 12,
  "maxSpread": 5000,
  "maxSteps": 200,
  "maxString": 200
 },
 "name": "PlaceOrder",
 "overlay": null,
 "projections": {
  "Bank": {
   "local": "offer {\n  receive Charge from Shop;\n  select {\n    send Charged to Shop;\n  } or {\n    send Declined to Shop;\n  }\n} or {\n}",
   "typestate": "start : S0\nS0.receive() : Charge -> S1 (from Shop) | nothing -> End\nS1.sendCharged(m : Charged) : End    -- to Shop\nS1.sendDeclined(m : Declined) : End    -- to Shop"
  },
  "Client": {
   "local": "send CreateOrder to Shop;\noffer {\n  receive Quote from Shop;\n  send Pay to Shop;\n  offer {\n    receive Receipt from Shop;\n  } or {\n    receive PaymentDeclined from Shop;\n  }\n} or {\n  receive SoldOut from Shop;\n}",
   "typestate": "start : S0\nS0.sendCreateOrder(m : CreateOrder) : S1    -- to Shop\nS1.receive() : Quote -> S2 (from Shop) | SoldOut -> End (from Shop)\nS2.sendPay(m : Pay) : S3    -- to Shop\nS3.receive() : Receipt -> End (from Shop) | PaymentDeclined -> End (from Shop)"
  },
  "Shop": {
   "local": "receive CreateOrder from Client;\nselect {\n  send Quote to Client;\n  receive Pay from Client;\n  send Charge to Bank;\n  offer {\n    receive Charged from Bank;\n    send Receipt to Client;\n  } or {\n    receive Declined from Bank;\n    send PaymentDeclined to Client;\n  }\n} or {\n  send SoldOut to Client;\n}",
   "typestate": "start : S0\nS0.receive() : CreateOrder -> S1    -- from Client\nS1.sendQuote(m : Quote) : S2    -- to Client\nS1.sendSoldOut(m : SoldOut) : End    -- to Client\nS2.receive() : Pay -> S3    -- from Client\nS3.sendCharge(m : Charge) : S4    -- to Bank\nS4.receive() : Charged -> S5 (from Bank) | Declined -> S6 (from Bank)\nS5.sendReceipt(m : Receipt) : End    -- to Client\nS6.sendPaymentDeclined(m : PaymentDeclined) : End    -- to Client"
  }
 },
