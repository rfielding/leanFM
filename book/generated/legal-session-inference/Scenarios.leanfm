import LeanFM.Session.Syntax

protocol ItemisedReturn (Tenant, Landlord, Registry) {
  lease: LeaseSigned from Landlord to Tenant;
  paid: DepositPaid from Tenant to Landlord cause lease;
  protection: DepositProtected from Landlord to Registry cause paid;
  ended: LeaseEnded from Tenant to Landlord;
  address: ForwardingAddress from Tenant to Landlord;
  itemised: DeductionsItemized from Landlord to Tenant cause address;
  DepositReturned from Landlord to Tenant cause address;
}

protocol LateReturnRepaired (Tenant, Landlord, Registry, Court) {
  lease: LeaseSigned from Landlord to Tenant;
  paid: DepositPaid from Tenant to Landlord cause lease;
  protection: DepositProtected from Landlord to Registry cause paid;
  ended: LeaseEnded from Tenant to Landlord;
  address: ForwardingAddress from Tenant to Landlord;
  returned: DepositReturned from Landlord to Tenant cause address;
  claim: ClaimFiled from Tenant to Court cause returned;
  judgment: Judgment from Court to Landlord cause claim;
  PenaltyPaid from Landlord to Tenant cause judgment;
}

protocol AddressLost (Tenant, Landlord, Registry, Post) {
  lease: LeaseSigned from Landlord to Tenant;
  paid: DepositPaid from Tenant to Landlord cause lease;
  protection: DepositProtected from Landlord to Registry cause paid;
  ended: LeaseEnded from Tenant to Landlord;
  posted: AddressPosted from Tenant to Post;
  BelievesViolated at Tenant;
}

protocol HardshipOffset (Tenant, Landlord, Registry) {
  lease: LeaseSigned from Landlord to Tenant;
  paid: DepositPaid from Tenant to Landlord cause lease;
  protection: DepositProtected from Landlord to Registry cause paid;
  hardship: HardshipRequest from Tenant to Landlord;
  offset: RentOffsetAgreed from Landlord to Tenant cause hardship;
  ended: LeaseEnded from Tenant to Landlord;
  address: ForwardingAddress from Tenant to Landlord;
  DepositReturned from Landlord to Tenant cause address;
}
