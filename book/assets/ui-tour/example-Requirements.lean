  , transitions := [{src := "proposed", dst := "open", message := "GameCreated", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "proposed", dst := "rejected", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatPlanSet", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatTaken", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatLeft", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "playing", message := "GameStarted", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "MovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "BotMovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "AutoPassed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "AutopilotSet", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "TeamsMerged", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "finished", message := "GameFinished", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
def customTasks : List TaskRequirement := [task_bot_turn, task_turn, task_team_merge, task_game_lifecycle]
def customGrammars : List TaskGrammar := [
  {task := "bot_turn", entry := "dispatching", terminals := ["played", "timed_out"], body := .seq (ev "bot_turn" "Server" "Bot" "BotTurn") (.choice [.seq (ev "bot_turn" "Bot" "Server" "BotMoveChosen") (ev "bot_turn" "Server" "Person" "BotMovePlayed"), .seq (ev "bot_turn" "Server" "Person" "TurnTimedOut") (GrammarExpr.optional (ev "bot_turn" "Bot" "Server" "BotMoveChosen"))])},
  {task := "turn", entry := "to_move", terminals := ["moved"], body := .choice [GrammarExpr.ref "play_move", GrammarExpr.ref "bot_turn", ev "turn" "Server" "Person" "TurnTimedOut", ev "turn" "Server" "Person" "AutoPassed"]},
  {task := "team_merge", entry := "idle", terminals := ["merged", "withdrawn", "rejected"], body := .seq (ev "team_merge" "Person" "Server" "ProposeMerge") (.choice [.seq (ev "team_merge" "Server" "Person" "MergeProposed") (.seq (GrammarExpr.star (.seq (ev "team_merge" "Person" "Server" "RespondMerge") (.choice [ev "team_merge" "Server" "Person" "MergeResponded", ev "team_merge" "Server" "Person" "RequestRejected"]))) (.choice [ev "team_merge" "Server" "Person" "TeamsMerged", ev "team_merge" "Server" "Person" "MergeWithdrawn"])), ev "team_merge" "Server" "Person" "RequestRejected"])},
  {task := "game_lifecycle", entry := "proposed", terminals := ["finished", "rejected"], body := GrammarExpr.seqList [GrammarExpr.ref "create_game", GrammarExpr.star (.choice [GrammarExpr.ref "set_seat_plan", GrammarExpr.ref "take_seat", GrammarExpr.ref "leave_seat", GrammarExpr.ref "join_game", GrammarExpr.ref "game_chat", GrammarExpr.ref "game_state"]), GrammarExpr.ref "start_game", GrammarExpr.star (.choice [GrammarExpr.ref "turn", GrammarExpr.ref "set_autopilot", GrammarExpr.ref "team_merge", GrammarExpr.ref "game_chat", GrammarExpr.ref "game_state"]), ev "game_lifecycle" "Server" "Person" "GameFinished", GrammarExpr.star (.choice [GrammarExpr.ref "game_state", GrammarExpr.ref "game_chat"])]}
]
def customProcesses : List RequirementProcess := [
  {actor := "Server", task := "bot_turn", states := ["dispatching", "searching", "chosen", "played", "timed_out"], sends := ["BotTurn", "BotMovePlayed", "TurnTimedOut"], receives := ["BotMoveChosen"]},
  {actor := "Bot", task := "bot_turn", states := ["dispatching", "searching", "chosen", "timed_out"], sends := ["BotMoveChosen"], receives := ["BotTurn"]},
  {actor := "Person", task := "bot_turn", states := ["searching", "played", "timed_out"], sends := [], receives := ["BotMovePlayed", "TurnTimedOut"]},
  {actor := "Person", task := "turn", states := ["to_move", "checking", "moved"], sends := ["PlayMove"], receives := ["MovePlayed", "RequestRejected", "BotMovePlayed", "TurnTimedOut", "AutoPassed"]},
  {actor := "Server", task := "turn", states := ["to_move", "checking", "searching", "chosen", "moved"], sends := ["MovePlayed", "RequestRejected", "BotTurn", "BotMovePlayed", "TurnTimedOut", "AutoPassed"], receives := ["PlayMove", "BotMoveChosen"]},
  {actor := "Bot", task := "turn", states := ["to_move", "searching", "chosen"], sends := ["BotMoveChosen"], receives := ["BotTurn"]},
  {actor := "Person", task := "team_merge", states := ["idle", "proposing", "pending", "responding", "merged", "withdrawn", "rejected"], sends := ["ProposeMerge", "RespondMerge"], receives := ["MergeProposed", "MergeResponded", "RequestRejected", "TeamsMerged", "MergeWithdrawn"]},
  {actor := "Server", task := "team_merge", states := ["idle", "proposing", "pending", "responding", "merged", "withdrawn", "rejected"], sends := ["MergeProposed", "MergeResponded", "RequestRejected", "TeamsMerged", "MergeWithdrawn"], receives := ["ProposeMerge", "RespondMerge"]},
  {actor := "Person", task := "game_lifecycle", states := ["proposed", "open", "playing", "finished", "rejected"], sends := [], receives := ["GameCreated", "RequestRejected", "SeatPlanSet", "SeatTaken", "SeatLeft", "GameStarted", "MovePlayed", "BotMovePlayed", "TurnTimedOut", "AutoPassed", "AutopilotSet", "TeamsMerged", "GameFinished"]},
  {actor := "Server", task := "game_lifecycle", states := ["proposed", "open", "playing", "finished", "rejected"], sends := ["GameCreated", "RequestRejected", "SeatPlanSet", "SeatTaken", "SeatLeft", "GameStarted", "MovePlayed", "BotMovePlayed", "TurnTimedOut", "AutoPassed", "AutopilotSet", "TeamsMerged", "GameFinished"], receives := []}
]
def viewOutputs (id title : String) : List DesiredOutput :=
  [{id := id ++ ".interaction", prompt := "Make the game behave like the N-Player Go Lab, with selectable bots, teams, history and MCTS estimates", question := "Which messages realize: " ++ title ++ "?", kind := .interactionDiagram, eventSource := id ++ " grammar in the current Project.Requirements.requirements", reducer := "render this current task grammar, preserving every branch", unit := "messages in one scenario"},
   {id := id ++ ".state", prompt := "Make the game behave like the N-Player Go Lab, with selectable bots, teams, history and MCTS estimates", question := "Which states and transitions realize: " ++ title ++ "?", kind := .stateMachine, eventSource := id ++ " task in the current Project.Requirements.requirements", reducer := "render the same specification's task states and message transitions", unit := "states/transitions in one scenario"}]
def requirements : RequirementSpec :=
  { id := "goserver", title := "GoServer: rooms, chat and N-player Go with bots, teams, history and search estimates"
  , actors := ["Person", "Server", "Bot"]
  , actorPopulations := [{actorSpec := "Person", instancePrefix := "person", count := 100, routing := .sticky "session_id"}, {actorSpec := "Server", instancePrefix := "server", count := 1, routing := .roundRobin}, {actorSpec := "Bot", instancePrefix := "bot-slot", count := 8, routing := .roundRobin}]
  , actorResources := [{actor := "Person", inboundCapacity := 64, outboundCapacity := 64, maxInFlight := 8, memoryBudgetBytes := 16777216}, {actor := "Server", inboundCapacity := 4096, outboundCapacity := 4096, maxInFlight := 1024, memoryBudgetBytes := 536870912}, {actor := "Bot", inboundCapacity := 64, outboundCapacity := 1, maxInFlight := 1, memoryBudgetBytes := 268435456}]
  , actorReliability := [], reliabilityGates := [], actorCosts := [], messages
  , tasks := (scenarios.map fun (id, title, request, response, _) => taskFor id title request response) ++ customTasks
  , grammars := (scenarios.map fun (id, _, request, response, _) => {task := id, entry := "ready", terminals := ["accepted", "rejected"], body := .seq (event id "Person" "Server" request) (.choice [event id "Server" "Person" response, event id "Server" "Person" "RequestRejected"]) }) ++ customGrammars
  , processes := (scenarios.flatMap fun (id, _, request, response, _) => [{actor := "Person", task := id, states := ["ready", "checking", "accepted", "rejected"], sends := [request], receives := [response, "RequestRejected"]}, {actor := "Server", task := id, states := ["ready", "checking", "accepted", "rejected"], sends := [response, "RequestRejected"], receives := [request]}]) ++ customProcesses
  , properties := [
      {name := "create_room authorized correlated result", task := "create_room", mode := .always, probability := none, expression := "A valid session creates one public room whose identifier is its trimmed, nonempty UTF-8 name of at most 128 characters; duplicate names, invalid input and the 16-room capacity limit reject without mutation; every result retains its request_id and task/session boundary"},
      {name := "list_rooms authorized correlated result", task := "list_rooms", mode := .always, probability := none, expression := "A valid server-issued session returns only visible room identifiers; every result retains its request_id and task/session boundary"},
      {name := "enter_room authorized correlated result", task := "enter_room", mode := .always, probability := none, expression := "The caller enters an existing visible room and receives that room and its game identifiers; every result retains its request_id and task/session boundary"},
      {name := "list_games authorized correlated result", task := "list_games", mode := .always, probability := none, expression := "A room member receives only metadata belonging to that room, including challenge name, server-issued ID, creator and open status"},
      {name := "join_game authorized correlated result", task := "join_game", mode := .always, probability := none, expression := "An authorized room member enters the selected game idempotently without receiving gameplay authority"},
      {name := "room_chat authorized correlated result", task := "room_chat", mode := .always, probability := none, expression := "A room member sends bounded text to that room only; sender and timestamp are server-assigned"},
      {name := "game_chat authorized correlated result", task := "game_chat", mode := .always, probability := none, expression := "A game member sends bounded text to that game only, with no implicit copy to parent room chat"},
      {name := "Browser navigation reflects server state", task := "list_rooms", mode := .always, probability := none, expression := "The local browser presents named room creation and entry, room-scoped named challenge creation and entry, and separate room/game chat using actual server results; pending actions and explicit errors remain visible; every enabled navigation control reaches a supported action; switching room or game clears stale content before displaying the new scope"},
      {name := "create_game authorized correlated result", task := "create_game", mode := .always, probability := none, expression := "A room member creates one fresh named open challenge with a server-issued ID; board size, seat count, deadlines, ko rule, bot settings and seat plan are validated, defaulted when zero, and retained in results and listings"},
      {name := "set_seat_plan creator controls the plan", task := "set_seat_plan", mode := .always, probability := none, expression := "Before the start, only the creator sets a seat's controller to bot or open and its team number (1 to seat count); a seat planned bot cannot be taken; setting a seat held by a person to bot first requires that person to leave"},
      {name := "take_seat authorized correlated result", task := "take_seat", mode := .always, probability := none, expression := "Each open seat holds at most one person, each person holds at most one seat per game, and seats change only before StartGame"},
      {name := "leave_seat before start", task := "leave_seat", mode := .always, probability := none, expression := "Before the start a seated person may leave; the seat becomes open with its planned team"},
      {name := "start_game fills seats with bots", task := "start_game", mode := .always, probability := none, expression := "After GameStarted every seat is controlled by exactly one person or one server-side bot, teams are as planned, the board is empty, nobody has losses, and seat 1 is to move"},
      {name := "set_autopilot keeps the seat", task := "set_autopilot", mode := .always, probability := none, expression := "A seated person may hand their seat to a bot (autopilot) and take it back at any time while playing; the seat, team and player name stay theirs; autopilot moves use the bot deadline and publish search summaries; taking it back during their own turn discards the pending bot result and gives the person the remainder of the human deadline measured from the start of the turn"},
      {name := "play_move rules", task := "play_move", mode := .always, probability := none, expression := "The board is bounded by a Wall; a placed stone removes every adjacent other-colour group without liberty and adds its stones to that owner's losses, recorded per capturing seat (the bowl); otherwise a placed group without liberty is removed as legal suicide and added to the mover's losses; Territory is an empty region bordered only by one colour and Wall; seat score = Territory - Losses; team score = sum of its members' territory minus sum of their losses; turns rotate through seats in order"},
      {name := "turns always end", task := "turn", mode := .always, probability := none, expression := "AG(to_move implies AF moved): every turn ends exactly once, by a person's move, a bot's move within its deadline, a timeout at the deadline, or an automatic pass for a resigned seat"},
      {name := "bot results are bound to their turn", task := "bot_turn", mode := .always, probability := none, expression := "A bot result changes the game only for the game, seat and turn revision it was dispatched for and only before that turn's deadline; the published move carries its search summary: playouts, milliseconds, the top candidates with visit counts, the mover's expected reward and every seat's projected final score and outlook, and whether the move replaced a pass to clean up dead stones"},
      {name := "merges need every person's consent", task := "team_merge", mode := .always, probability := none, expression := "A proposal names the proposer's team and another team; both teams must contain a seated person; it merges them into one team (the smaller team number) once every person seated in either team accepts; any decline, a change to either team, or the game finishing withdraws it; merges are permanent; bots of merged teams search for the merged team's score"},
      {name := "games always finish", task := "game_lifecycle", mode := .always, probability := none, expression := "AG(playing implies AF finished): the game finishes when every remaining seat has passed since the last stone, after one full round of timeouts, or at 3*N*N moves; GameFinished announces team scores and the winning team or teams in the game chat"},
      {name := "game_state reflects the authoritative game", task := "game_state", mode := .always, probability := none, expression := "GameState reports the current board, territory owner, per-seat controller, team, territory, losses with the per-capturer bowl, score and resignation, team totals, pending merge proposals, seat to move, move number, remaining time and, from since_move on, every move record with victims and bot search summaries; winners are the seats of the team or teams with the highest team score that still have a member who has not resigned"},
      {name := "Lab-style viewer", task := "game_state", mode := .always, probability := none, expression := "The browser presents the N-Player Go Lab experience against server state: board with Wall coordinates, territory squares, last-move and next-move markers; Home/Back/Forward/End and previous/next variation by buttons and arrow keys; a variation tree and next-move chips; a Search panel listing the viewed position's candidates (visit share and reward) with a heat overlay; per-seat Territory, Bowl, Score, Proj. and Outlook and team totals; a clickable projected-score timeline; GIF export of the viewed line; stone, capture and final-ten-seconds sounds with a toggle; it follows live moves while the viewer is at the latest move and otherwise shows that new moves arrived"},
      {name := "Analysis is local", task := "game_state", mode := .always, probability := none, expression := "Variations and local Monte Carlo searches run in the viewer's browser on a copy of the position, are never sent to the server, never change the game, and are lost when the page closes; watchers may branch and search at any time; seated people may browse the actual moves during play and may branch and search once the game has finished"},
      {name := "propose_merge correlated result", task := "propose_merge", mode := .always, probability := none, expression := "A seated person's proposal to merge their team with another team that contains a seated person is recorded once with a server-issued proposal ID, visible to every game member, or rejected without mutation"},
      {name := "respond_merge correlated result", task := "respond_merge", mode := .always, probability := none, expression := "Each person seated in either team of a pending proposal records one acceptance or a decline; the result reports whether the proposal is still pending, merged or withdrawn"}
    ]
  , requiredProofs := [
      {name := "create_room never crosses authority or scope", task := "create_room", mode := .never, probability := none, predicate := "an invalid or expired session, malformed or oversized input, replay or concurrent admission leaks credentials, borrows another identity, or mutates rejected state"},
      {name := "list_rooms never crosses authority or scope", task := "list_rooms", mode := .never, probability := none, predicate := "an invalid or expired session discloses private identities or credentials"},
      {name := "enter_room never crosses authority or scope", task := "enter_room", mode := .never, probability := none, predicate := "a foreign room ID or unauthorized caller crosses the room boundary or mutates rejected state"},
      {name := "list_games never crosses authority or scope", task := "list_games", mode := .never, probability := none, predicate := "a foreign room ID or unauthorized caller receives game metadata from another room"},
      {name := "join_game never crosses authority or scope", task := "join_game", mode := .never, probability := none, predicate := "a foreign game ID or unauthorized caller receives membership or gameplay authority"},
      {name := "room_chat never crosses authority or scope", task := "room_chat", mode := .never, probability := none, predicate := "chat is delivered outside room membership, sender identity is borrowed, or user text executes as HTML or script"},
      {name := "game_chat never crosses authority or scope", task := "game_chat", mode := .never, probability := none, predicate := "chat is delivered outside game membership or copied into the parent room chat"},
      {name := "Browser never fabricates destinations or crosses scopes", task := "list_rooms", mode := .never, probability := none, predicate := "a placeholder link or fabricated room/challenge is presented as available; a late response for an old room/game overwrites the current conversation; user text executes as HTML or script; a session token appears in the page, URL or logs; malformed, foreign-origin or unauthorized room creation mutates state"},
      {name := "create_game never crosses authority or scope", task := "create_game", mode := .never, probability := none, predicate := "a foreign room ID, replay or concurrent admission duplicates a game or delivers it outside its room, or an out-of-range parameter or seat plan is accepted"},
      {name := "set_seat_plan never crosses authority", task := "set_seat_plan", mode := .never, probability := none, predicate := "anyone but the creator changes the plan, the plan changes after the start, or a seat held by a person is turned into a bot seat"},
      {name := "take_seat never crosses authority or scope", task := "take_seat", mode := .never, probability := none, predicate := "a person outside the game or room takes a seat, a bot seat or taken seat is assigned, one person holds two seats, or a seat changes after the start"},
      {name := "leave_seat never crosses authority", task := "leave_seat", mode := .never, probability := none, predicate := "a person leaves another person's seat or leaves after the start"},
      {name := "start_game never crosses authority or scope", task := "start_game", mode := .never, probability := none, predicate := "anyone but the creator starts a game, a started game restarts, or a bot replaces a seated person"},
      {name := "set_autopilot never crosses authority", task := "set_autopilot", mode := .never, probability := none, predicate := "a person toggles autopilot for a seat that is not theirs, autopilot moves after its owner took the seat back, or a person's seat is reassigned by autopilot"},
      {name := "play_move never crosses authority or scope", task := "play_move", mode := .never, probability := none, predicate := "a person moves for another seat, for an autopilot seat, or out of turn; a stale move number or replayed request changes the board twice; a move arriving after its deadline is accepted instead of the timeout; an occupied or off-board point, a ko-forbidden recapture or a situational-superko repetition is accepted; or a move is accepted after the game finished"},
      {name := "turns never end twice", task := "turn", mode := .never, probability := none, predicate := "a person's move, a bot result, a timeout and an automatic pass both end the same turn"},
      {name := "bots never act outside their turn", task := "bot_turn", mode := .never, probability := none, predicate := "a bot result is applied to another game, seat or turn revision, after the turn's deadline, or for a seat a person controls; or a client submits a move on behalf of a bot"},
      {name := "bots never exhaust the server", task := "bot_turn", mode := .never, probability := none, predicate := "more bot searches run at once than the Bot population, a search runs without a time budget, or a search holds the authoritative game state while it runs"},
      {name := "merges never happen without consent", task := "team_merge", mode := .never, probability := none, predicate := "teams merge without every person seated in both teams accepting, a team with no person is merged, a bot accepts for a person, a person outside both teams responds, a merge is undone, or a merge happens before the start or after the finish"},
      {name := "game_state never crosses authority or scope", task := "game_state", mode := .never, probability := none, predicate := "a person who has not joined the game reads its state, or the reported board differs from the authoritative board at the reported move number"},
      {name := "analysis never leaks into the game", task := "game_state", mode := .never, probability := none, predicate := "a local variation or local search result is sent to the server or shown as an actual move; or a person seated in a game in play can create variations or run local search on it in the provided browser"},
      {name := "games never stall", task := "game_lifecycle", mode := .never, probability := none, predicate := "a started game has no seat to move and is not finished, or a finished game accepts moves, seat changes or merges"}
    ]
  , performance := [], charts := []
  , desiredOutputs := (scenarios.flatMap fun (id, title, _, _, _) => viewOutputs id title) ++ (customTasks.flatMap fun t => viewOutputs t.id t.title) ++ [
      {id := "game.score_timeline", prompt := "Show the MCTS estimations like the N-Player Go Lab", question := "How did each seat's projected final score evolve along the viewed line?", kind := .function2d, eventSource := "BotMovePlayed search summaries in GameState.moves, plus the viewer's own local searches", reducer := "for each move on the viewed line, the projected final score per seat from the search at that position, or the parent search's statistics for that move; gaps where no search exists", unit := "points per seat against move number"},
      {id := "game.result", prompt := "Teams to let users merge together", question := "Which team won, by how much?", kind := .scalar, eventSource := "GameFinished and the final GameState", reducer := "team score = sum of members' territory minus sum of members' losses; highest team score wins", unit := "points"}]
  , markdown := [
      {id := "scope", title := "Current slice", body := "Named chat rooms, room challenge listings, watch/join, room chat and isolated game chat; N-player Go modelled on the stakeholder's N-Player Go Lab: per-seat bot/person control planned by the creator, autopilot for seated people, preset teams and consensual permanent merges, server-side max-n Monte Carlo tree search bots with published search summaries, timed turns, scoring with per-capturer bowls, and a Lab-style browser with history, variations, local analysis, projected-score timeline, sounds and GIF export. Handicaps, ratings, persistence, SGF export, push transport and moderation administration are deferred."},
      {id := "rules", title := "N-player Go rules", body := "Two to eight seats on a 5, 7, 9, 11, 13 or 19 line board bounded by a Wall. Seats take turns in order. After a stone is placed every adjacent group of another colour with no liberty is removed and counted as that owner's losses (its bowl records which seat captured it); if nothing was captured and the placed group has no liberty it is removed as suicide and counted as the mover's losses. Suicide is legal. Territory is an empty region bordered only by one colour's stones and the Wall. Seat score = Territory - Losses; team score is the sum over its members. With the ko rule on, simple ko plus situational superko forbid a stone that recreates an earlier board with the same seat to move, compared exactly rather than by hash alone; passes, timeouts and resignations are never rejected for repetition; Auto turns the rule on only for two seats. A turn not answered by the deadline is a timeout: it neither ends nor resets the passing round; a full round of timeouts abandons the game, scored as it stands. The game ends when every remaining seat has passed since the last stone, or at 3*N*N moves. A resigned seat passes automatically. The winners are the team or teams with the highest team score among teams with at least one member who has not resigned."},
      {id := "params", title := "Challenge parameters and defaults", body := "board_size 5/7/9/11/13/19, default 11; seats 2-8, default 4; turn_deadline_ms for people 5,000-3,840,000, default 10,000; bot_ms 250-16,000, default 1,000; ko_rule 0 Auto (default), 1 Off, 2 simple ko plus situational superko; explore_milli (UCT exploration constant x1000) 500, 700 (default), 1000 or 1400; reward_mode margin (soft margin against the best rival, default), win (win or shared win) or rank; softness 2, 4 (default) or 8 points for the margin reward. Zero or empty means the default. seat_plan lists, per seat, controller bot or open (default open) and team (default its own seat number)."},
      {id := "seats", title := "Seat control", body := "The creator plans every seat before the start as bot or open and assigns teams; people in the room open the challenge and take open seats or leave them. StartGame turns every seat still without a person into a bot named bot-<seat>. While playing, the person in a seat can switch autopilot on (a server bot plays the seat with the bot deadline and published search) and off; the seat remains theirs. Nobody can move for another person's seat, and no client can submit a bot's move."},
      {id := "teams", title := "Teams and merges", body := "Teams are numbered; a seat's planned team defaults to its seat number, so everyone plays alone unless the creator groups seats. During play, a seated person proposes merging their team with another; both teams must contain at least one seated person; every person seated in either team must accept; any decline withdraws it. Merges are permanent and adopt the smaller team number. Bots on a team search for the team's combined score. Pending proposals, acceptances and the people still to answer are visible to every game member."},
      {id := "analysis", title := "History, variations and local analysis", body := "Every viewer can step through the actual moves. Variations and the viewer's own Monte Carlo searches run in the browser with the same rules engine as the Lab, are never sent to the server, and vanish when the page closes. Watchers may branch and search at any time; a person seated in a game in play may only browse the actual moves until the game finishes. Each bot move publishes its search summary when it is played: candidates with visit share and reward, and per seat the projected final score (Proj.) and outlook. The projected-score timeline uses those summaries and the viewer's local searches."},
      {id := "identity", title := "Identity and navigation boundaries", body := "Use an existing server-issued authenticated session; this slice does not add account registration or provider API credentials. EnterRoom authorizes room membership; JoinGame authorizes game chat membership within that room. Creator and sender are server-derived identities, never trusted request fields. Watch/join both enter a chat container and grant no gameplay authority."},
      {id := "bounds", title := "Bounded observable inputs and overload", body := "Room names trim surrounding whitespace, are unique case-sensitive display identifiers and are never interpreted as paths or markup. At most 16 rooms exist including the lobby, and at most 64 challenges exist per room. All state is in memory and resets on restart. Names are nonempty UTF-8 up to 128 characters; chat bodies are nonempty UTF-8 up to 4000 characters; each room/game retains its latest 100 chat entries. The 100 Person instances are a first-slice capacity forecast, not measured throughput. Full queues reject with a busy result without mutation; the separate implementation mapping must bound connections and enforce the actor resource contracts."},
      {id := "correlation", title := "Correlation, replay and failure", body := "Request IDs are unique per authenticated session and task. Each request produces exactly one success or RequestRejected with the same request_id. Duplicate mutation IDs return the prior result, and conflicting reuse with another body is rejected. Structured game listings retain their GameListed record fields. Scenario trace envelopes must retain event identity, session/task and cause_id independently of prior ordering; HTTP conversion, runtime and storage choices await the separate mapping."},
      {id := "validation", title := "Meaning of this check", body := "This revision is proposed for requirements acceptance; previous protected acceptance snapshots are retained and do not accept these changes. The checker establishes Lean elaboration, protobuf agreement, structural completeness and current-spec diagram provenance. It does not prove that the deployed server satisfies the temporal, isolation, concurrency, resource or security obligations; those are mapped to controls and negative tests by the separate implementation specification."}
    ] }
end Project.Requirements
