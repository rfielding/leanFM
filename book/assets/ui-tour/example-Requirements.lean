def scenarios : List (String × String × String × String × String) := [
  ("create_room", "Create a named chat room", "CreateRoom", "RoomCreated", "A valid session creates one public room whose identifier is its trimmed, nonempty UTF-8 name of at most 128 characters; duplicate names, invalid input and the 16-room capacity limit reject without mutation; the creator then uses EnterRoom to enter it")
, ("list_rooms", "List the available chat rooms", "ListRooms", "RoomsListed", "A valid server-issued session returns only visible room identifiers")
, ("enter_room", "Enter a room and inspect its game list", "EnterRoom", "RoomEntered", "The caller enters an existing visible room; the response names that room and its own game identifiers")
, ("list_games", "List room games and open challenges", "ListGames", "GamesListed", "A room member receives only game/challenge metadata belonging to that room, including each challenge name, server-issued ID, creator and open status")
, ("join_game", "Watch or enter a game chat container", "JoinGame", "GameJoined", "An authorized room member enters the selected game; repeated entry is idempotent and does not grant gameplay authority")
, ("room_chat", "Send room chat", "SendRoomChat", "RoomChat", "A room member sends bounded text to that room only; sender and timestamp are assigned by the server")
, ("game_chat", "Send game chat", "SendGameChat", "GameChat", "A game member sends bounded text to that game only; no implicit copy is added to the parent room chat")
, ("create_game", "Create a challenge with board, bot and seat settings", "CreateGame", "GameCreated", "A room member creates one open challenge with a bounded name, a server-issued ID, validated board parameters, bot search settings and an optional seat plan (bot or open, and team, per seat); the result and later listings retain them")
, ("set_seat_plan", "Plan a seat as bot or open and set its team", "SetSeatPlan", "SeatPlanSet", "Before the start, the creator marks one seat as played by a bot or open for a person, and sets its team")
, ("take_seat", "Take an open seat", "TakeSeat", "SeatTaken", "A member of the game and its room takes one empty seat planned as open (or the first such seat) before the start; one seat per person per game")
, ("leave_seat", "Leave a seat before the start", "LeaveSeat", "SeatLeft", "A seated person leaves their seat before the start; it becomes open again")
, ("start_game", "Start a game; bots fill the remaining seats", "StartGame", "GameStarted", "Only the creator starts an open game; every seat without a person is played by a server-side search bot and seat 1 moves first")
, ("set_autopilot", "Hand my seat to a bot, or take it back", "SetAutopilot", "AutopilotSet", "A seated person lets a server bot play their seat (autopilot) or takes it back; the seat stays theirs")
, ("play_move", "Play a stone, pass or resign", "PlayMove", "MovePlayed", "The person controlling the seat to move plays a legal stone, a pass or a resignation at the current move number before the deadline")
, ("propose_merge", "Propose merging two teams", "ProposeMerge", "MergeProposed", "A seated person proposes merging their team with another team during play")
, ("respond_merge", "Accept or decline a merge proposal", "RespondMerge", "MergeResponded", "A person seated in either team of a pending proposal accepts or declines it")
, ("game_state", "Watch the board, clocks, scores, teams and record", "GetGameState", "GameState", "A game member reads the authoritative position, seats, teams, proposals, clock and the move record from a given move number, including the search summary of each bot move")
]
def taskFor (id title request response : String) : TaskRequirement :=
  { id, title, actors := ["Person", "Server"], initialState := "ready"
  , states := [{id := "ready", label := "Ready", group := "client", markdown := "Request not yet issued", terminal := false},
               {id := "checking", label := "Server checks identity, scope and bounds", group := "server", markdown := "No mutation is committed before validation", terminal := false},
               {id := "accepted", label := "Correlated result", group := "terminal", markdown := "One authoritative result", terminal := true},
               {id := "rejected", label := "Explicit rejection without mutation", group := "terminal", markdown := "No private state is echoed", terminal := true}]
  , transitions := [{src := "ready", dst := "checking", message := request, probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "accepted", message := response, probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "rejected", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }

def event (task src dst message : String) : GrammarExpr := .event {task, src, dst, message}
def ev := event
def task_bot_turn : TaskRequirement :=
  { id := "bot_turn", title := "A server bot plays one turn", actors := ["Server", "Bot", "Person"], initialState := "dispatching"
  , states := [{id := "dispatching", label := "Turn starts for a bot-controlled seat", group := "server", markdown := "Position and history are copied for the search", terminal := false},
               {id := "searching", label := "Bot searches with a time budget", group := "bot", markdown := "Max-n Monte Carlo tree search outside the game lock", terminal := false},
               {id := "chosen", label := "Result checked against game, seat and turn revision", group := "server", markdown := "Illegal or stale results become a pass or are discarded", terminal := false},
               {id := "played", label := "Move and its search summary published", group := "terminal", markdown := "Visible to every game member", terminal := true},
               {id := "timed_out", label := "Turn ended by its deadline", group := "terminal", markdown := "A late result is discarded", terminal := true}]
  , transitions := [{src := "dispatching", dst := "searching", message := "BotTurn", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "chosen", message := "BotMoveChosen", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "chosen", dst := "played", message := "BotMovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "timed_out", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "timed_out", dst := "timed_out", message := "BotMoveChosen", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
