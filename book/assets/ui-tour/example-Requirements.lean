               {id := "proposing", label := "Server checks the proposal", group := "server", markdown := "Proposer seated; both teams contain a person", terminal := false},
               {id := "pending", label := "Waiting for every person in both teams", group := "server", markdown := "Acceptances recorded per person", terminal := false},
