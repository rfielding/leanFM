-- Illustrative choice probabilities, not measurements.
protocol NestedOrders (Shop, Client) {
  choice at Shop using declared("service") {
    probability 3/4:
      Priority from Shop to Client;
      choice at Shop using declared("priorityOutcome") {
        probability 2/3:
          Shipped from Shop to Client;
      } or {
        probability 1/3:
          Cancelled from Shop to Client;
      }
  } or {
    probability 1/4:
      Standard from Shop to Client;
      choice at Shop using declared("standardOutcome") {
        probability 1/5:
          Shipped from Shop to Client;
      } or {
        probability 4/5:
          Backordered from Shop to Client;
      }
  }
}
