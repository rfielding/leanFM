import LeanFM.Artifacts

namespace LeanFM.ReliabilityDiagram
open LeanFM

/-- Inputs to the reusable vertical series/parallel/threshold topology view. -/
structure Topology where
  browserLabel : String
  seriesPools : List ActorPopulation
  shards : List ActorPopulation
  gates : List ReliabilityDependencyGate

def gateFor? (topology : Topology) (population : ActorPopulation) :
    Option ReliabilityDependencyGate :=
  topology.gates.find? fun gate => gate.id == population.actorSpec

def thresholdLabel (topology : Topology) (population : ActorPopulation) : String :=
  match gateFor? topology population with
  | none => "missing gate"
  | some gate => toString gate.requiredCount ++ " of " ++ toString gate.members.length

def memberLabel (population : ActorPopulation) : String :=
  String.intercalate "\\\\" population.instanceIds

def node (id x y label width : String) : String :=
  "\\node[actorbox,text width=" ++ width ++ "cm] (" ++ id ++ ") at (" ++ x ++ "," ++ y ++ ") {" ++ label ++ "};\n"

/-- Render a Kubernetes-like actor topology from typed populations and gates.
Project examples provide data; LeanFM owns the drawing rule. -/
def renderTeX (topology : Topology) : String :=
  "% Generated by LeanFM.ReliabilityDiagram.renderTeX.\n" ++
  "\\begin{tikzpicture}[actorbox/.style={draw=diagramink,text=diagramink,rounded corners,fill=diagramsurface,align=center,font=\\scriptsize,inner sep=5pt},dep/.style={->,>=Stealth,draw=leanblue,thick}]\n" ++
  node "browser" "5" "0" topology.browserLabel "2.8" ++
  String.join ((topology.seriesPools.zipIdx).map fun (population, i) =>
    node ("p" ++ toString i) "5" ("-" ++ toString ((i + 1) * 2))
      ("\\textbf{" ++ population.actorSpec ++ " actors}\\\\" ++ memberLabel population ++
        "\\\\parallel: " ++ thresholdLabel topology population) "2.8") ++
  "\\draw[dep] (browser) -- (p0);\n\\draw[dep] (p0) -- node[right,font=\\scriptsize]{requires} (p1);\n\\draw[dep] (p1) -- node[right,font=\\scriptsize]{requires} (p2);\n" ++
  "\\node[font=\\scriptsize,align=center,text=diagramink,text width=3cm] at (1,-4) {Stages are in series,\\\\from top to bottom.\\\\Replicas within each\\\\pool provide parallel\\\\failover.};\n" ++
  "\\draw[draw=leanblue,thick] (p2.south) -- (5,-7.3);\n\\draw[draw=leanblue,thick] (0,-7.3) -- (10,-7.3);\n" ++
  String.join ((topology.shards.zipIdx).map fun (population, i) =>
    let x := toString (i * 10) ++ "/7"
    node ("s" ++ toString i) x "-8.7"
      ("\\textbf{" ++ population.actorSpec ++ "}\\\\" ++ memberLabel population ++
        "\\\\parallel\\\\writes: " ++ thresholdLabel topology population) "1.05" ++
    "\\draw[dep] (" ++ x ++ ",-7.3) -- (s" ++ toString i ++ ".north);\n") ++
  "\\node[font=\\scriptsize,align=center,text=diagramink,text width=10.7cm] at (5,-10.7) {Shards are parallel data partitions with separate availability gates.\\\\Each shard has parallel replicas; writes need a primary and a threshold quorum.\\\\A targeted write selects one shard, not all shards.};\n\\end{tikzpicture}\n"

end LeanFM.ReliabilityDiagram
