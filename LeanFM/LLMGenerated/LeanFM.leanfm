import LeanFM.Session.Syntax

/-- LeanFM's own MCP protocol (clause selfhost.mcp.session.project-files): the agent (Claude Desktop,
    Claude Code, Codex) and the MCP Apps view both reach the LeanFM server only through the host, and
    the server reads a project piecemeal from the project's root (Disk). The view loads one bounded
    answer at a time: the stage, then a section or a page of it, then one protocol file, which a
    session tool reads by project and file instead of carrying its text, and for session_conform a
    window of a server log (clause selfhost.session.real-events: a real run showed that read). -/
structure Open where
  project : String
  stage : String

structure Page where
  project : String
  section : String
  offset : Nat

structure Load where
  project : String
  file : String

/-- How a LeanFM server starts (clauses selfhost.env.launch, selfhost.session.event-log): the shell
    launches it, stamping the time, and the server tells the shell when it reaches main and when it
    listens, as event lines on its standard output. Reaching main must take at most a second: what a
    program computes before main is invisible to its own logs. -/
protocol ServerStart (Shell, Server) {
  l: Launch from Shell to Server;
  clock launched = time(l);
  obligation StartsQuickly on Server {
    trigger launched;
    require MainEntered within 1000 ms;
    on breach record SlowStart;
  }
  MainEntered from Server to Shell cause l;
  Listening from Server to Shell cause l;
}

/-- Every MCP request a LeanFM server answers, as it writes it to its log (clause
    selfhost.session.event-log): any number at once, each a Call when it arrives and an Answer
    when its answer is written. The Answer's payload says what kind of request it was and how
    many bytes it answered, which is what load measurement reads. -/
protocol McpCall (Client, Server) {
  sessions {
    c: Call from Client to Server;
    Answer from Server to Client cause c;
  }
}

protocol LeanFMMcp (Agent, Host, View, Server, Disk) {
  i: Initialize from Host to Server route "POST /mcp";
  Initialized from Server to Host cause i status 200;
  l: ListTools from Host to Server route "POST /mcp";
  Tools from Server to Host cause l status 200;
  loop Ask {
    choice {
      o: Open from Agent to Host;
      v: ProjectView from Host to Server cause o route "POST /mcp";
      sessions { r: ReadRoot from Server to Disk; Listing from Disk to Server cause r; }
      choice {
        Shown from Server to Host cause v status 200;
        Render from Host to View cause o;
        sessions {
          loop Browse {
            choice {
              p: Page from View to Host;
              pv: ProjectView from Host to Server cause p route "POST /mcp";
              sessions { rp: ReadPage from Server to Disk; Items from Disk to Server cause rp; }
              choice {
                PageShown from Server to Host cause pv status 200;
                Paged from Host to View cause p;
                continue Browse;
              } or {
                OverBound from Server to Host cause pv status 413;
                Refused from Host to View cause p;
                continue Browse;
              }
            } or {
              f: Load from View to Host;
              st: SessionTool from Host to Server cause f route "POST /mcp";
              sessions { rf: ReadFile from Server to Disk; FileText from Disk to Server cause rf; }
              sessions { rl: ReadLog from Server to Disk; LogLines from Disk to Server cause rl; }
              choice {
                Checked from Server to Host cause st status 200;
                Drawn from Host to View cause f;
                continue Browse;
              } or {
                NotListed from Server to Host cause st status 403;
                Refused from Host to View cause f;
                continue Browse;
              }
            } or {
              Close from View to Host;
            }
          }
        }
        Done from Host to Agent cause o;
        continue Ask;
      } or {
        TooLarge from Server to Host cause v status 413;
        Failed from Host to Agent cause o;
        continue Ask;
      }
    } or {
      Quit from Agent to Host;
      b: Bye from Host to Server route "POST /mcp";
      ByeDone from Server to Host cause b status 200;
    }
  }
}

/- LeanFM's own requirements (clause selfhost.requirements.map): each converts to CTL, or uses sorry.
   The clauses of SelfHosting.lean join this list as sorry entries until one of these replaces them. -/
requirements {
  selfhost.session.event_log "Every MCP request a server takes is answered" => McpCall ⊨ (stronglyImplies (on Call) (inevitably (on Answer)));
  selfhost.env.launch "A server listens only after reaching main" => ServerStart ⊨ (precedes (on MainEntered) (on Listening));
  selfhost.session.real_events "The MCP conversation follows LeanFMMcp" => LeanFMMcp;
  InitializedFirst "No project view or tool before the server is initialized" => LeanFMMcp ⊨ (precedes (on Initialized) (or (on ProjectView) (on SessionTool)));
  selfhost.mcp.session.navigator "Every page the view asks for is shown or refused" => LeanFMMcp ⊨ (leadsTo (on Page) (or (on Paged) (on Refused)));
  LoadsAnswered "Every protocol the view loads is drawn or refused" => LeanFMMcp ⊨ (leadsTo (on Load) (or (on Drawn) (on Refused)));
  selfhost.mcp.session.project_files "A file the project does not list is refused" => LeanFMMcp ⊨ (stronglyImplies (on NotListed) (allNext (on Refused)));
  selfhost.mcp.session.standalone "The session ends only with Bye" => LeanFMMcp ⊨ (always (implies stop (on ByeDone)));
  CanAlwaysEnd "The session can always end" => LeanFMMcp ⊨ (always (possibly stop));
  selfhost.mcp.logic.implication "When a trigger can never happen, a feature written with strong implication fails and a guarantee written with weak implication holds, in every model" => sorry "a property of CTL's semantics, proved for every model";
  selfhost.mcp.limits "A call that raises a limit gets at most the limit's default times the operator's factor, whatever it asks for" => sorry "a property of CallLimits.validate, proved for every argument";
  PathsInside "A protocol file a requirement or a tool names stays inside the project: never absolute, never with a .. or empty part or a backslash, and a project's name never holds / or ." => sorry "a property of LeanFM's path checks, not of a protocol";
  selfhost.requirements.standing "A run is judged with four values: not twice is the identity, and and or commute, De Morgan holds, one run never refutes a possibly nor proves an always" => sorry "a property of RunCheck, the run judge, not of a protocol";
  SettingsChecked "A switch read at startup is the default only when absent or empty, true only for 1 or true, false only for 0 or false, every other value refused; a limit ceiling or tick budget read is at least 1" => sorry "a property of the startup parsers, proved for every input";
  SecretsUnwritten "A secret variable's setting in a server's MainEntered event is the same whatever its value" => sorry "a property of Env.entry, proved for every value";
  McpNeverWrites "Answering an MCP request never writes, creates, renames or removes a file, changes a permission, or runs a process that writes" => sorry "a property of the MCP server's code, checked over the built environment";
  SubmittedLogicInert "Reading and judging a submitted formula, task, trace or reduce_run program reaches no file, network, process, environment or clock" => sorry "a property of the logic tools' and reduce_run's code, checked over the built environment";
  ReduceNamesClosed "A reduce_run program runs only if every name in it is a number, true, false, a primitive, a define or a name it binds; while it runs, a name means nothing else" => sorry "a property of Reduce.unbound and Reduce.resolve, proved for every program";
  CheckerProved "LeanFM's CTL checker is exact for all 14 operators on every finite model; holds checks the states it explored before it answers, and the implication rule holds of it" => sorry "a property of LeanFM.CTL.label, proved for every finite model";
}
