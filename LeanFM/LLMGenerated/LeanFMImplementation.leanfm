import LeanFM.Session.Syntax

/-- LeanFM's implementation of its own requirements (clause selfhost.implementations.map): evidence
for each requirement of LeanFM.leanfm, CTL about what no agent observes (the server's reads of the
project root), and hints for whoever writes the code. -/
implementation Lean of LeanFM.LLMGenerated.LeanFM {
  "Every MCP request a server takes is answered" => conform "LeanFM/LLMGenerated/runs/mcp-call.jsonl";
  "A server listens only after reaching main" => conform "LeanFM/LLMGenerated/runs/server-start.jsonl";
  "The MCP conversation follows LeanFMMcp" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "No project view or tool before the server is initialized" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "Every page the view asks for is shown or refused" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "Every protocol the view loads is drawn or refused" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "A file the project does not list is refused" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "The session ends only with Bye" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "The session can always end" => conform "LeanFM/LLMGenerated/runs/leanfm-mcp.jsonl";
  "Every read of the project root is answered" => LeanFMMcp ⊨ (stronglyImplies (on ReadPage) (allNext (on Items)));
  "selfhost.requirements.standing" => proof "LeanFM.RunCheck.Proofs.standing_laws";
  "PathsInside" => proof "LeanFM.PathProofs.paths_stay_inside";
  "selfhost.mcp.logic.implication" => proof "LeanFM.CTLProofs.implication_rule";
  "selfhost.mcp.limits" => proof "LeanFM.LimitProofs.validate_within_ceiling";
  "SettingsChecked" => proof "LeanFM.StartupProofs.startup_checked";
  "SecretsUnwritten" => proof "LeanFM.StartupProofs.secret_never_written";
  "SubmittedLogicInert" => pure "LeanFM.Logic.run LeanFM.Reduce.check";
  "ReduceNamesClosed" => proof "LeanFM.ReduceProofs.submitted_programs_closed";
  "CheckerProved" => proof "LeanFM.CheckerProofs.holds_and_checker_proved";
  hint "Implement in Lean 4; the server is one executable built with lake";
  hint "The MCP surface is read-only: no tool writes, renames or deletes a file";
  hint "Read the project root only through ProjectView.inside, so a symlink cannot escape it";
}
