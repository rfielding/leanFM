import LeanFM.MDP

namespace LeanFM.MDPDiagram

structure StateNode where
  id : String
  label : String
  x : Int
  y : Int
  terminal : Bool := false

structure TransitionEdge where
  src : String
  dst : String
  label : String

structure InteractionMessage where
  src : String
  dst : String
  label : String

structure Outcome where
  label : String
  weight : Nat

structure PriorEvent where
  id : String
  label : String
  x : Int
  y : Int
  priorIds : List String

def stateNodeTeX (node : StateNode) : String :=
  let style := if node.terminal then "state,accepting" else "state"
  "\\node[" ++ style ++ "] (" ++ node.id ++ ") at (" ++ toString node.x ++ "," ++
    toString node.y ++ ") {" ++ node.label ++ "};\n"

/-- Reusable state/transition rendering for a checked MDP projection. -/
def renderStateTeX (nodes : List StateNode) (edges : List TransitionEdge) : String :=
  "% Generated by LeanFM.MDPDiagram.renderStateTeX.\n" ++
  "\\begin{tikzpicture}[->,>=Stealth,every state/.style={draw=diagramink,text=diagramink,fill=diagramsurface,rounded corners,minimum height=7mm,font=\\scriptsize},edge/.style={draw=leanblue,thick},every edge/.style={draw=leanblue,thick}]\n" ++
  String.join (nodes.map stateNodeTeX) ++
  String.join (edges.map fun edge =>
    "\\draw[edge] (" ++ edge.src ++ ") -- node[fill=pagebackground,text=diagramink,font=\\scriptsize,align=center] {" ++
      edge.label ++ "} (" ++ edge.dst ++ ");\n") ++
  "\\end{tikzpicture}\n"

/-- Render the stored event order directly.  Arrows point backward from each
event to every event ID in its `priorIds`, rather than suggesting forward
implication. -/
def renderPriorGraphTeX (events : List PriorEvent) : String :=
  "% Generated by LeanFM.MDPDiagram.renderPriorGraphTeX.\n" ++
  "\\begin{tikzpicture}[event/.style={draw=diagramink,text=diagramink,fill=diagramsurface,rounded corners,minimum width=4.4cm,minimum height=8mm,align=center,font=\\scriptsize},prior/.style={->,>=Stealth,draw=leanblue,thick}]\n" ++
  String.join (events.map fun event =>
    "\\node[event] (" ++ event.id ++ ") at (" ++ toString event.x ++ "," ++
      toString event.y ++ ") {\\texttt{" ++ event.id ++ "}\\\\" ++ event.label ++ "};\n") ++
  String.join (events.flatMap fun event => event.priorIds.map fun prior =>
    "\\draw[prior] (" ++ event.id ++ ") -- (" ++ prior ++ ");\n") ++
  "\\end{tikzpicture}\n"

def actorX (actors : List String) (actor : String) : Nat :=
  match actors.findIdx? (fun candidate => candidate == actor) with
  | some i => i * 6
  | none => 0

/-- Reusable interaction rendering. Message direction is drawn as an arrow and
never encoded as an implication-like line of prose. -/
def renderInteractionTeX (actors : List String) (messages : List InteractionMessage) : String :=
  "% Generated by LeanFM.MDPDiagram.renderInteractionTeX.\n" ++
  "\\begin{tikzpicture}[actor/.style={draw=diagramink,text=diagramink,fill=diagramsurface,rounded corners,minimum width=2.3cm,minimum height=7mm,font=\\small},message/.style={->,>=Stealth,draw=leanblue,thick}]\n" ++
  String.join ((actors.zipIdx).map fun (actor, i) =>
    let x := i * 6
    "\\node[actor] (a" ++ toString i ++ ") at (" ++ toString x ++ ",0) {" ++ actor ++ "};\n" ++
    "\\draw[dashed,draw=diagramink] (a" ++ toString i ++ ".south) -- ++(0,-" ++ toString (messages.length + 1) ++ ");\n") ++
  String.join ((messages.zipIdx).map fun (message, i) =>
    let src := actors.findIdx? (fun actor => actor == message.src) |>.getD 0
    let dst := actors.findIdx? (fun actor => actor == message.dst) |>.getD 0
    let y := i + 1
    "\\draw[message] (" ++ toString (src * 6) ++ ",-" ++ toString y ++ ") -- node[above,fill=pagebackground,text=diagramink,font=\\scriptsize] {" ++
      message.label ++ "} (" ++ toString (dst * 6) ++ ",-" ++ toString y ++ ");\n") ++
  "\\end{tikzpicture}\n"

/-- Reusable probability-mass bar chart. Weights are shown relative to their
sum so no floating-point approximation enters the checked model. -/
def renderOutcomeBarsTeX (outcomes : List Outcome) : String :=
  let total := outcomes.foldl (fun sum outcome => sum + outcome.weight) 0
  "% Generated by LeanFM.MDPDiagram.renderOutcomeBarsTeX.\n" ++
  "\\begin{tikzpicture}\\begin{axis}[ybar,bar width=18pt,ymin=0,ymax=1.05,width=.78\\textwidth,height=5cm,ylabel={terminal probability},symbolic x coords={" ++
  String.intercalate "," (outcomes.map Outcome.label) ++
  "},xtick=data,nodes near coords,axis line style={draw=diagramink},tick label style={text=diagramink},label style={text=diagramink},nodes near coords style={text=diagramink},ymajorgrids,grid style={draw=leangray!35}]\n\\addplot[fill=leanblue,draw=leanblue] coordinates {" ++
  String.intercalate " " (outcomes.map fun outcome =>
    "(" ++ outcome.label ++ "," ++ LeanFM.fixed4Text outcome.weight total ++ ")") ++
  "};\\end{axis}\\end{tikzpicture}\n"

end LeanFM.MDPDiagram
