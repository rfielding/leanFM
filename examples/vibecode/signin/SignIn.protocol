/-- Signing in with an identity provider (OAuth authorization code). The App handles the start and
    the callback as two separate requests, so it serves each in its own session. -/
protocol SignIn (Browser, App, Idp) {
  sessions {
    sessions {
      s: Start from Browser to App route "GET /login";
      RedirectToIdp from App to Browser cause s status 302;
    }
    a: Authorize from Browser to Idp route "GET /authorize";
    choice {
      LoginPage from Idp to Browser cause a status 200;
      c: Credentials from Browser to Idp route "POST /login";
      choice {
        RedirectBack from Idp to Browser cause c status 302;
        sessions {
          cb: Callback from Browser to App route "GET /callback";
          t: ExchangeCode from App to Idp cause cb route "POST /token";
          choice {
            Tokens from Idp to App cause t status 200;
            SignedIn from App to Browser cause cb status 302;
          } or {
            BadCode from Idp to App cause t status 400;
            SignInFailed from App to Browser cause cb status 401;
          }
        }
      } or {
        WrongPassword from Idp to Browser cause c status 401;
      }
    } or {
      AlreadySignedIn from Idp to Browser cause a status 302;
    }
  }
}
