import LeanFM.Session.Syntax

/-- What the client orders. -/
structure CreateOrder where
  item : String
  quantity : Nat

/-- The shop's price for the order, in cents. -/
structure Quote where
  price : Nat

/-- The client pays; the card number is a secret, never logged. -/
structure Pay where
  amount : Nat
  card_secr : String

structure Charge where
  amount : Nat
  card_secr : String

structure Receipt where
  amount : Nat

/-- What is required: the conversation between a client, a shop and a bank, message by message. -/
protocol PlaceOrder (Client, Shop, Bank) {
  o: CreateOrder from Client to Shop route "POST /orders";
  choice {
    q: Quote from Shop to Client cause o status 201;
    p: Pay from Client to Shop cause q where p.amount = q.price;
    c: Charge from Shop to Bank cause p;
    choice {
      d: Charged from Bank to Shop cause c;
      Receipt from Shop to Client cause d status 200;
    } or {
      x: Declined from Bank to Shop cause c;
      PaymentDeclined from Shop to Client cause x status 402;
    }
  } or {
    SoldOut from Shop to Client cause o status 409;
  }
}

requirements {
  "Orders are placed as PlaceOrder says" => PlaceOrder;
  "Every order is answered" => PlaceOrder ⊨ (leadsTo (on CreateOrder) (or (on Receipt) (on PaymentDeclined) (on SoldOut)));
  "Every payment is charged to the bank" => PlaceOrder ⊨ (leadsTo (on Pay) (on Charge));
  "No receipt without a charge" => PlaceOrder ⊨ (precedes (on Charged) (on Receipt));
  "A sold-out order is never charged" => PlaceOrder ⊨ (always (implies (on SoldOut) (never (on Charge))));
  "Refunds within 30 days" => sorry "PlaceOrder has no Refund message yet";
}
