import LeanFM.Render
import spec.Requirements

/-! Derived views of `Project.Requirements.requirements`. Every file written
here is regenerated by `make views`; none is maintained by hand. Output goes
to `renders/` under the project root. -/

open LeanFM
open Project.Requirements

private def firstNodePerTask (seen : List String) : List AggregateNode → List String
  | [] => []
  | node :: rest =>
      if seen.contains node.task then firstNodePerTask seen rest
      else node.id :: firstNodePerTask (node.task :: seen) rest

private def stackComponents : List String → List String → List String
  | terminal :: terminals, _ :: nextRoot :: roots =>
      ("  " ++ jsonString terminal ++ " -> " ++ jsonString nextRoot ++
        " [style=invis,weight=100,minlen=2];") :: stackComponents terminals (nextRoot :: roots)
  | _, _ => []

def darkGraph (name rankdir : String) (body : List String) (label : String := "") : String :=
  joinWithNewline <|
    [ "digraph " ++ name ++ " {"
    , "  rankdir=" ++ rankdir ++ ";"
    , "  graph [bgcolor=\"#111111\",fontcolor=white,label=" ++ jsonString label ++ "];"
    , "  node [shape=box,style=\"rounded,filled\",fillcolor=\"#1f2937\",fontcolor=white,color=\"#60a5fa\",fontname=\"monospace\"];"
    , "  edge [fontcolor=white,color=\"#94a3b8\"];" ] ++ body ++ ["}"]

def aggregateDot (name : String) (graph : AggregateGraphData) : String :=
  let terminals := (graph.nodes.filter (·.terminal)).map (·.id)
  darkGraph name "TB" <|
    graph.nodes.map (fun n => "  " ++ jsonString n.id ++ " [label=" ++ jsonString n.label ++ "];") ++
    graph.edges.map (fun e => "  " ++ jsonString e.src ++ " -> " ++ jsonString e.dst ++ " [label=" ++ jsonString e.label ++ "];") ++
    stackComponents terminals (firstNodePerTask [] graph.nodes)

def taskGraph (task : String) : AggregateGraphData :=
  let all := requirementAggregateGraphData requirements
  { nodes := all.nodes.filter (·.task == task)
  , edges := all.edges.filter (fun e => stringContains e.src (task ++ ".")) }

def eventLabel (event : ScenarioEvent) : String :=
  joinWithNewline <| [event.id ++ ": " ++ event.message, event.src ++ " -> " ++ event.dst] ++
    event.fieldValues.map (fun f => f.1 ++ " = " ++ f.2)

/-- The prior-pointer order graph of one concrete scenario. -/
def messageOrderDot (name : String) (events : List ScenarioEvent) : String :=
  darkGraph name "BT" (label := "arrows point to immediate prior events") <|
    events.map (fun e => "  " ++ jsonString e.id ++ " [label=" ++ jsonString (eventLabel e) ++ "];") ++
    concatLists (events.map fun e => e.priorIds.map fun p =>
      "  " ++ jsonString e.id ++ " -> " ++ jsonString p ++ ";")

def task! (id : String) : TaskRequirement :=
  (requirements.tasks.find? (·.id == id)).getD
    { id, title := id, actors := [], initialState := "", states := [], transitions := [] }

def views : List (String × String) :=
  [ ("paxos-kv.dot", aggregateDot "paxos_kv" (requirementAggregateGraphData requirements))
  , ("quorum-write.dot", aggregateDot "quorum_write" (taskGraph "quorum_write"))
  , ("linearizable-list.dot", aggregateDot "linearizable_list" (taskGraph "linearizable_list"))
  , ("recover-replica.dot", aggregateDot "recover_replica" (taskGraph "recover_replica"))
  , ("quorum-write-messages.dot", messageOrderDot "quorum_write_messages" quorumWriteExample)
  , ("quorum-write-interaction.svg", interactionSvg requirements (task! "quorum_write"))
  , ("linearizable-list-interaction.svg", interactionSvg requirements (task! "linearizable_list"))
  , ("recover-replica-interaction.svg", interactionSvg requirements (task! "recover_replica"))
  , ("quorum-write-state.svg", stateMachineSvg requirements (task! "quorum_write"))
  , ("linearizable-list-state.svg", stateMachineSvg requirements (task! "linearizable_list"))
  , ("recover-replica-state.svg", stateMachineSvg requirements (task! "recover_replica"))
  , ("quorum-shutdown-network.svg", quorumShutdownNetworkSvg requirements) ]

def main : IO Unit := do
  IO.FS.createDirAll "renders"
  for (name, body) in views do
    IO.FS.writeFile ("renders/" ++ name) body
    IO.println ("wrote renders/" ++ name)
