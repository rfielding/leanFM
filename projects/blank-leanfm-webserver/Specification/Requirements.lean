import LeanFM.Artifacts

namespace LeanFMProject.Requirements
open LeanFM

inductive Actor where | UserBrowser | LeanFMServer | ModelProvider deriving DecidableEq, Repr
instance : RequirementName Actor where style := .raw

def frame : MessageFraming := { kind := .protobufOneof, dispatchField := some "payload", note := "EventEnvelope payload oneof selects the canonical protobuf atom" }
def f (n : Nat) (name : String) (scalar : ProtoScalar := .string) : ProtoFieldSchema := { number := n, name, scalar }
def m (name src dst : String) (fields : List ProtoFieldSchema) : MessageSchema := { name, src, dst, framing := frame, fields }
def U := "UserBrowser"
def S := "LeanFMServer"
def P := "ModelProvider"

def messages : List MessageSchema := [
