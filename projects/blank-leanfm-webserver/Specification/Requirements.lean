 m "ArtifactListRequested" U S [f 1 "project_id",f 2 "kind_filter",f 3 "scenario_filter",f 4 "status_filter"],m "ArtifactListReturned" S U [f 1 "artifacts" .bytes],m "ArtifactOpenRequested" U S [f 1 "artifact_id",f 2 "revision" .uint64],m "ArtifactOpened" S U [f 1 "artifact_id",f 2 "revision" .uint64,f 3 "status",f 4 "media_type",f 5 "content" .bytes,f 6 "provenance"]]

def state (id : String) (terminal := false) : RequirementState := { id, label := id, group := "protocol", markdown := "Residual protocol state", terminal }
def tr (a b msg : String) : RequirementTransition := { src:=a,dst:=b,message:=msg,probabilityNum:=1,probabilityDen:=1,dwellMs:=0 }
def atom (task msg : String) : GrammarExpr :=
  match messages.find? (fun x => x.name == msg) with
  | some x => .event {task,src:=x.src,dst:=x.dst,message:=msg}
  | none => .empty
def seq (task : String) (xs : List String) := GrammarExpr.seqList (xs.map (atom task))
def alt (task : String) (xss : List (List String)) := GrammarExpr.alt (xss.map (seq task))

def taskData : List (String × String × List String × List RequirementTransition × GrammarExpr) := [
 ("authenticate_user","signed_out",["authenticated","rejected"],[tr "signed_out" "submitted" "LoginSubmitted",tr "submitted" "authenticated" "LoginAccepted",tr "submitted" "rejected" "LoginRejected"], seq "authenticate_user" ["LoginSubmitted"] >>> alt "authenticate_user" [["LoginAccepted"],["LoginRejected"]]),
 ("create_account","registration",["created","rejected"],[tr "registration" "checking" "AccountCreateSubmitted",tr "checking" "verifying" "ProviderKeyCheckRequested",tr "verifying" "verified" "ProviderKeyVerified",tr "verified" "created" "AccountCreated",tr "verifying" "key_rejected" "ProviderKeyRejected",tr "key_rejected" "rejected" "AccountCreateRejected"],seq "create_account" ["AccountCreateSubmitted","ProviderKeyCheckRequested"] >>> alt "create_account" [["ProviderKeyVerified","AccountCreated"],["ProviderKeyRejected","AccountCreateRejected"]]),
 ("manage_projects","ready",["listed","created","opened","deleted"],[tr "ready" "listed" "ProjectListRequested",tr "listed" "listed" "ProjectListReturned",tr "ready" "created" "ProjectCreateRequested",tr "created" "created" "ProjectCreated",tr "ready" "opened" "ProjectOpenRequested",tr "opened" "opened" "ProjectOpened",tr "ready" "deleted" "ProjectDeleteRequested",tr "deleted" "deleted" "ProjectDeleted"],alt "manage_projects" [["ProjectListRequested","ProjectListReturned"],["ProjectCreateRequested","ProjectCreated"],["ProjectOpenRequested","ProjectOpened"],["ProjectDeleteRequested","ProjectDeleted"]]),
 ("configure_provider","unconfigured",["configured","rejected"],[tr "unconfigured" "submitted" "ProviderCredentialSubmitted",tr "submitted" "configured" "ProviderCredentialAccepted",tr "submitted" "rejected" "ProviderCredentialRejected"],seq "configure_provider" ["ProviderCredentialSubmitted"] >>> alt "configure_provider" [["ProviderCredentialAccepted"],["ProviderCredentialRejected"]]),
 ("argue_requirements","ready",["rendered","failed"],[tr "ready" "requested" "ChatPromptSubmitted",tr "requested" "waiting" "ModelRequestIssued",tr "waiting" "returned" "ModelResponseReturned",tr "returned" "rendered" "ChatResponseRendered",tr "waiting" "failed" "ChatTurnFailed"],seq "argue_requirements" ["ChatPromptSubmitted","ModelRequestIssued"] >>> alt "argue_requirements" [["ModelResponseReturned","ChatResponseRendered"],["ChatTurnFailed"]]),
 ("markerboard","editing",["candidate"],[tr "editing" "preview" "MermaidDraftSaved",tr "preview" "promote" "MermaidPreviewRendered",tr "editing" "media" "MediaUploaded",tr "media" "promote" "MediaRendered",tr "promote" "updating" "ArtifactPromoted",tr "updating" "candidate" "CandidateRequirementUpdated"],alt "markerboard" [["MermaidDraftSaved","MermaidPreviewRendered","ArtifactPromoted","CandidateRequirementUpdated"],["MediaUploaded","MediaRendered","ArtifactPromoted","CandidateRequirementUpdated"]]),
 ("inspect_artifacts","closed",["listed","opened"],[tr "closed" "listed" "ArtifactListRequested",tr "listed" "listed" "ArtifactListReturned",tr "listed" "opening" "ArtifactOpenRequested",tr "opening" "opened" "ArtifactOpened"],seq "inspect_artifacts" ["ArtifactListRequested","ArtifactListReturned"] >>> GrammarExpr.optional (seq "inspect_artifacts" ["ArtifactOpenRequested","ArtifactOpened"])),
 ("inspect_task_model","closed",["linked","sequence_visible","object_visible"],[tr "closed" "linking" "TaskModelRequested",tr "linking" "linked" "TaskModelReturned",tr "linked" "sequence_request" "MessageSequenceRequested",tr "sequence_request" "sequence_visible" "MessageSequenceReturned",tr "sequence_visible" "object_request" "ProtobufObjectRequested",tr "object_request" "object_visible" "ProtobufObjectReturned"],seq "inspect_task_model" ["TaskModelRequested","TaskModelReturned"] >>> GrammarExpr.optional (seq "inspect_task_model" ["MessageSequenceRequested","MessageSequenceReturned"] >>> GrammarExpr.optional (seq "inspect_task_model" ["ProtobufObjectRequested","ProtobufObjectReturned"]))),
 ("research_web","ready",["returned","failed"],[tr "ready" "dispatch" "WebResearchRequested",tr "dispatch" "provider" "WebResearchDispatched",tr "provider" "searched" "WebSearchPerformed",tr "searched" "opened" "WebPageOpened",tr "opened" "returned" "WebResearchReturned",tr "provider" "failed" "WebResearchFailed"],seq "research_web" ["WebResearchRequested","WebResearchDispatched"] >>> alt "research_web" [["WebSearchPerformed","WebPageOpened","WebResearchReturned"],["WebResearchFailed"]]),
 ("assist_markerboard","editing",["helped","updated","rejected"],[tr "editing" "helped" "MarkerboardAssistRequested",tr "helped" "helped" "MarkerboardSyntaxHelpReturned",tr "helped" "dispatch" "MarkerboardAssistDispatched",tr "dispatch" "returned" "MarkerboardAssistReturned",tr "returned" "proposed" "MarkerboardPatchProposed",tr "proposed" "accepted" "MarkerboardPatchAccepted",tr "accepted" "updated" "MarkerboardDraftUpdated",tr "proposed" "rejected" "MarkerboardPatchRejected"],seq "assist_markerboard" ["MarkerboardAssistRequested"] >>> alt "assist_markerboard" [["MarkerboardSyntaxHelpReturned"],["MarkerboardAssistDispatched","MarkerboardAssistReturned","MarkerboardPatchProposed","MarkerboardPatchAccepted","MarkerboardDraftUpdated"],["MarkerboardAssistDispatched","MarkerboardAssistReturned","MarkerboardPatchProposed","MarkerboardPatchRejected"]])]

def allStates (entry : String) (terms : List String) (ts : List RequirementTransition) :=
  ([entry] ++ ts.flatMap (fun x => [x.src,x.dst])).eraseDups.map (fun id => state id (terms.contains id))
def actorsFor (ts : List RequirementTransition) :=
  (ts.flatMap fun t => match messages.find? (fun x => x.name==t.message) with | some x => [x.src,x.dst] | none => []).eraseDups
def tasks := taskData.map fun (id,entry,terms,ts,_) => {id:=id,title:=id.replace "_" " ",actors:=actorsFor ts,initialState:=entry,states:=allStates entry terms ts,transitions:=ts : TaskRequirement}
def grammars := taskData.map fun (id,entry,terms,_,body) => {task:=id,entry,terminals:=terms,body : TaskGrammar}
def processes := taskData.flatMap fun (id,_,_,ts,_) => (actorsFor ts).map fun a =>
  { actor:=a, task:=id, states:=(tasks.find? (fun t=>t.id==id)).map (fun t=>t.states.map (fun s=>s.id)) |>.getD [],
    sends:=ts.filterMap fun t => (messages.find? (fun x=>x.name==t.message)).bind fun x => if x.src==a then some t.message else none,
    receives:=ts.filterMap fun t => (messages.find? (fun x=>x.name==t.message)).bind fun x => if x.dst==a then some t.message else none : RequirementProcess }

def properties := (taskData.map fun (id,_,terms,_,_) => {name:=id++"_legal_residual",mode:=.always,task:=id,expression:="AG (accepted event implies event is admitted by the current residual grammar); terminals=" ++ String.intercalate "," terms,probability:=none : RequirementProperty}) ++
  [{name:="finite_blocking_queues",mode:=.always,task:="inspect_task_model",expression:="every actor queue has declared capacity; a full send or empty blocking receive sleeps without mutation until progress is possible",probability:=none},
   {name:="paired_measurement_boundaries",mode:=.always,task:="inspect_task_model",expression:="every time or byte delta joins a terminal event to its declared start through prior_ids within one session and task",probability:=none},
   {name:="parameter_dependency_cascade",mode:=.always,task:="inspect_task_model",expression:="changing a typed parameter invalidates and regenerates every transitive dependent production reducer proof codec and view",probability:=none},
   {name:="http_production_roundtrip",mode:=.always,task:="inspect_task_model",expression:="each HTTP-bound production has a byte-exact encoder and decoder whose round trip preserves the protobuf value and residual-grammar legality",probability:=none}]
  ++ [{name:="closed_queues_drain",mode:=.always,task:="inspect_task_model",expression:="close forbids later pushes, preserves accepted buffered values for ordered draining, wakes blocked operations, and ends iteration exactly at closed and empty",probability:=none}]
def proofs := (taskData.map fun (id,_,_,_,_) => {name:=id++"_eventual_terminal",mode:=.eventually,task:=id,predicate:="AF terminal or explicit rejection/failure",probability:=none : RequiredProof}) ++
  [{name:="Full queues make no progress",mode:=.always,task:="inspect_task_model",predicate:="a send at declared capacity sleeps without enqueue drop reorder duplication or mutation until space exists",probability:=none},
   {name:="Measured deltas use explicit pairs",mode:=.always,task:="inspect_task_model",predicate:="every displayed duration or byte delta follows terminal prior_ids to the declared start and subtracts like units",probability:=none},
   {name:="HTTP codecs round trip",mode:=.always,task:="inspect_task_model",predicate:="decode(encode(value)) equals value for every HTTP-bound production and the decoded atom is legal in the residual grammar",probability:=none}]
  ++ [{name:="Closed queues are finite streams",mode:=.always,task:="inspect_task_model",predicate:="after close no push succeeds and each previously accepted value is yielded exactly once before iteration returns closed",probability:=none}]
def outputs : List DesiredOutput := taskData.flatMap fun (id,_,_,_,_) => [
  {id:=id++"_interaction",prompt:="Book chapter 12 requires generated interaction views",question:="What messages pass among actors in this task?",kind:=.interactionDiagram,eventSource:="EventEnvelope stream filtered by task_id="++id,reducer:="project src,dst,payload in predecessor order",unit:="diagram"},
  {id:=id++"_state",prompt:="Book chapter 12 requires residual grammar views",question:="Which protocol states and transitions are reachable?",kind:=.stateMachine,eventSource:="EventEnvelope stream filtered by task_id="++id,reducer:="replay payloads through task grammar residuals",unit:="state machine"}]

def spec : RequirementSpec := {
 id:="leanfm-chatui-web-protocol", title:="LeanFM web-server observable protocol",
 actors:=[U,S,P], actorPopulations:=[{actorSpec:=U,instancePrefix:="browser-",count:=8,routing:=.sticky "session_id"},{actorSpec:=S,instancePrefix:="server-",count:=1,routing:=.sticky "project_id"},{actorSpec:=P,instancePrefix:="provider-",count:=2,routing:=.sticky "credential_ref"}],
 actorResources:=[{actor:=U,inboundCapacity:=32,outboundCapacity:=32,maxInFlight:=4,memoryBudgetBytes:=67108864},{actor:=S,inboundCapacity:=256,outboundCapacity:=256,maxInFlight:=32,memoryBudgetBytes:=536870912},{actor:=P,inboundCapacity:=64,outboundCapacity:=64,maxInFlight:=16,memoryBudgetBytes:=268435456}],
 actorReliability:=[],reliabilityGates:=[],actorCosts:=[],messages:=messages,tasks:=tasks,grammars:=grammars,processes:=processes,properties:=properties,requiredProofs:=proofs,performance:=[],charts:=[],desiredOutputs:=outputs,
 markdown:=[{id:="book_scope",title:="Normative scope",body:="Chapter 12 accepted typed grammar and canonical protobuf bytes. HTTP routes and transports remain for Implementation Gate 2."},{id:="initial_capacity_profile",title:="Finite blocking queues",body:="Browser/session queues are 32/32 with four in flight and 64 MiB; the server is 256/256 with 32 in flight and 512 MiB; provider workers are 64/64 with 16 in flight and 256 MiB. Full sends and empty blocking receives sleep without mutation. These are explicit initial parameters, not measured production claims."},{id:="progressive_grammar_canvas",title:="Progressive grammar and paired evidence",body:="The entire grammar is a navigable open/close canvas. Collapsed productions retain boundary IDs, prior links, parameter assignments, deltas, and validation. Parameter edits cascade to transitive dependents. HTTP-bound productions attach byte-exact codecs and round-trip fixtures."}]
}

def all : List GeneratedRequirement := [.requirement spec]
def validationReport : String := generatedRequirementValidationReport all

end LeanFMProject.Requirements
