 m "MarkerboardAssistRequested" U S [f 1 "project_id",f 2 "artifact_id",f 3 "base_revision" .uint64,f 4 "diagram_kind",f 5 "source",f 6 "instruction",f 7 "mode",f 8 "credential_ref"], m "MarkerboardSyntaxHelpReturned" S U [f 1 "artifact_id",f 2 "base_revision" .uint64,f 3 "help_markdown"], m "MarkerboardAssistDispatched" S P [f 1 "request_id",f 2 "artifact_id",f 3 "base_revision" .uint64,f 4 "diagram_kind",f 5 "source",f 6 "instruction"], m "MarkerboardAssistReturned" P S [f 1 "request_id",f 2 "proposed_source",f 3 "explanation",f 4 "input_tokens" .uint64,f 5 "output_tokens" .uint64], m "MarkerboardPatchProposed" S U [f 1 "artifact_id",f 2 "base_revision" .uint64,f 3 "proposed_source",f 4 "explanation"], m "MarkerboardPatchAccepted" U S [f 1 "artifact_id",f 2 "base_revision" .uint64,f 3 "proposed_source"], m "MarkerboardPatchRejected" U S [f 1 "artifact_id",f 2 "base_revision" .uint64], m "MarkerboardDraftUpdated" S U [f 1 "artifact_id",f 2 "revision" .uint64,f 3 "source"],
 m "ProjectListRequested" U S [f 1 "user_id"],m "ProjectListReturned" S U [f 1 "project_ids"],m "ProjectCreateRequested" U S [f 1 "display_name"],m "ProjectCreated" S U [f 1 "project_id",f 2 "display_name"],m "ProjectOpenRequested" U S [f 1 "project_id"],m "ProjectOpened" S U [f 1 "project_id",f 2 "current_requirements_revision"],m "ProjectDeleteRequested" U S [f 1 "project_id",f 2 "confirmation"],m "ProjectDeleted" S U [f 1 "project_id"],
 m "ProviderCredentialSubmitted" U S [f 1 "provider",f 2 "api_key" .bytes,f 3 "retention"],m "ProviderCredentialAccepted" S U [f 1 "credential_ref",f 2 "billing_source"],m "ProviderCredentialRejected" S U [f 1 "reason"],
 m "ChatPromptSubmitted" U S [f 1 "project_id",f 2 "conversation_id",f 3 "message_id",f 4 "parts" .bytes,f 5 "attachment_ids",f 6 "credential_ref"],m "ModelRequestIssued" S P [f 1 "project_id",f 2 "conversation_id",f 3 "request_id",f 4 "model",f 5 "research_mode"],m "ModelResponseReturned" P S [f 1 "request_id",f 2 "parts" .bytes,f 3 "input_tokens" .uint64,f 4 "cached_input_tokens" .uint64,f 5 "output_tokens" .uint64,f 6 "context_window_tokens" .uint64],m "ChatResponseRendered" S U [f 1 "conversation_id",f 2 "message_id",f 3 "parts" .bytes,f 4 "artifact_ids",f 5 "input_tokens" .uint64,f 6 "cached_input_tokens" .uint64,f 7 "output_tokens" .uint64,f 8 "context_window_tokens" .uint64,f 9 "usage_warning"],m "ChatTurnFailed" S U [f 1 "request_id",f 2 "reason"],
