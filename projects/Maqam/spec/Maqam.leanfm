import LeanFM.Session.Syntax

/-- maqam-live, reverse-engineered from upstream c80b35d (see book chapter "Reverse
    engineering"). The Performer types command lines into the App (the TUI and main thread);
    the App owns the authoritative timeline and sends AudioCmd values on a bounded channel
    (512) to the Audio callback, which sequences, synthesizes and mixes in real time and never
    answers on that channel: it publishes position and meters through atomics, which the App
    reads every frame (Position). Recording, LLM requests, NAM downloads and TONE3000 login
    each run on their own worker thread and answer the App on a bounded(1) channel, so the TUI
    and the audio never wait for them. Disk is the working directory (sessions, .nam cache,
    recordings); Ffmpeg is the external encoder; Llm is OpenAI or Anthropic; Web is any
    http(s) host a NAM pin, a search or TONE3000 names. -/
structure Command where
  line : String

structure Phrase where
  id : Nat
  source : String

structure Audio where
  kind : String

structure Saved where
  path : String

structure Prompt where
  provider : String
  text : String

structure Commands where
  count : Nat

structure Fetch where
  url : String
  name : String

protocol MaqamLive (Performer, App, Audio, Recorder, Ffmpeg, Llm, Web, Disk) {
  loop Live {
    choice {
      -- a timeline edit: the App updates its timeline first, then tells the audio
      c: Command from Performer to App;
      choice {
        sessions { Phrase from App to Audio; Position from Audio to App; }
        Shown from App to Performer cause c;
        continue Live;
      } or {
        Rejected from App to Performer cause c;
        continue Live;
      }
    } or {
      -- save or load a session: MAQAM_SESSION_V3 text in the working directory
      s: Session from Performer to App;
      w: ReadOrWrite from App to Disk cause s;
      choice {
        Done from Disk to App cause w;
        sessions { Resync from App to Audio; }
        Loaded from App to Performer cause s;
        continue Live;
      } or {
        Failed from Disk to App cause w;
        LoadFailed from App to Performer cause s;
        continue Live;
      }
    } or {
      -- record: an offline render on a worker thread, encoded by ffmpeg
      m: Record from Performer to App;
      r: Render from App to Recorder cause m;
      e: Encode from Recorder to Ffmpeg cause r;
      choice {
        Encoded from Ffmpeg to Recorder cause e;
        mp: WriteMp4 from Recorder to Disk cause r;
        Written from Disk to Recorder cause mp;
        Saved from Recorder to App cause r;
        RecordDone from App to Performer cause m;
        continue Live;
      } or {
        EncodeFailed from Ffmpeg to Recorder cause e;
        RenderFailed from Recorder to App cause r;
        RecordFailed from App to Performer cause m;
        continue Live;
      }
    } or {
      -- an LLM edit: commands come back as a tool call, are checked, then applied or rolled back
      p: Prompt from Performer to App;
      q: Ask from App to Llm cause p;
      choice {
        Commands from Llm to App cause q;
        choice {
          sessions { Apply from App to Audio; }
          Applied from App to Performer cause p;
          continue Live;
        } or {
          RolledBack from App to Performer cause p;
          continue Live;
        }
      } or {
        Answer from Llm to App cause q;
        Explained from App to Performer cause p;
        continue Live;
      } or {
        LlmFailed from Llm to App cause q;
        AskFailed from App to Performer cause p;
        continue Live;
      }
    } or {
      -- a NAM capture: downloaded into the cache, then loaded on the live input
      n: Fetch from Performer to App;
      g: Download from App to Web cause n;
      choice {
        Model from Web to App cause g;
        k: CacheWrite from App to Disk cause n;
        Cached from Disk to App cause k;
        sessions { NamModel from App to Audio; }
        NamLoaded from App to Performer cause n;
        continue Live;
      } or {
        DownloadFailed from Web to App cause g;
        NamFailed from App to Performer cause n;
        continue Live;
      }
    } or {
      Quit from Performer to App;
      sessions { Stop from App to Audio; }
    }
  }
}

/- The requirements over MaqamLive that convert to CTL, each decided by LeanFM (session_ctl), none
   vacuous. They hold under LeanFM's default assumptions: messages arrive in order, none is lost
   and no thread crashes. The live loop runs until the performer quits, so "is answered" is the
   weak form: no stop before the answer. The sorry entries are claims about values, files,
   blocking or failures (spec/Requirements.lean), which are not message order. -/
requirements {
  "The live app follows MaqamLive" => MaqamLive;
  "Timeline first, audio second" => MaqamLive ⊨ (precedes (on Command) (on Phrase));
  "After a command is shown, the audio gets no phrase until the next command" => MaqamLive ⊨ (stronglyImplies (on Shown) (allUnless (not (on Phrase)) (on Command)));
  "A rejected command changes nothing" => MaqamLive ⊨ (stronglyImplies (on Rejected) (allUnless (not (on Phrase)) (on Command)));
  "Every command is answered" => MaqamLive ⊨ (stronglyImplies (on Command) (allUnless (not stop) (or (on Shown) (on Rejected))));
  "Every save or load is answered" => MaqamLive ⊨ (stronglyImplies (on Session) (allUnless (not stop) (or (on Loaded) (on LoadFailed))));
  "The audio resyncs only after the disk succeeds" => MaqamLive ⊨ (precedes (on Done) (on Resync));
  "A failed load leaves the audio alone" => MaqamLive ⊨ (stronglyImplies (on LoadFailed) (allUnless (not (on Resync)) (on Session)));
  "Every recording is answered" => MaqamLive ⊨ (stronglyImplies (on Record) (allUnless (not stop) (or (on RecordDone) (on RecordFailed))));
  "A recording is reported done only after its mp4 is written" => MaqamLive ⊨ (precedes (on Written) (on RecordDone));
  "Every prompt is answered" => MaqamLive ⊨ (stronglyImplies (on Prompt) (allUnless (not stop) (or (on Applied) (on RolledBack) (on Explained) (on AskFailed))));
  "LLM commands are checked before any is applied" => MaqamLive ⊨ (precedes (on Commands) (on Apply));
  "Returned LLM commands are applied or rolled back" => MaqamLive ⊨ (stronglyImplies (on Commands) (allUnless (not stop) (or (on Applied) (on RolledBack))));
  "A rolled-back LLM edit applies nothing" => MaqamLive ⊨ (stronglyImplies (on RolledBack) (allUnless (not (on Apply)) (on Prompt)));
  "Every NAM fetch is answered" => MaqamLive ⊨ (stronglyImplies (on Fetch) (allUnless (not stop) (or (on NamLoaded) (on NamFailed))));
  "A download is cached before it is loaded" => MaqamLive ⊨ (precedes (on Cached) (on NamModel));
  "Quit stops the audio" => MaqamLive ⊨ (stronglyImplies (on Quit) (inevitably (on Stop)));
  "The app stops only after Quit" => MaqamLive ⊨ (precedes (on Quit) stop);
  -- values of the timeline, the tuning and the session text, not message order
  "Entry ids are stable" => sorry;
  "Jump passes" => sorry;
  "Just intonation" => sorry;
  "Session round trip" => sorry;
  -- which commands an LLM answer holds: a value of Commands
  "The LLM never saves, loads, records or plays" => sorry;
  -- files on disk and samples written
  "A failed recording leaves no partial mp4" => sorry;
  "Renders are deterministic" => sorry;
  "Cache writes stay in the cache" => sorry;
  "Secrets stay out of files, scores and prompts" => sorry;
  -- blocking and crashing are not messages of MaqamLive
  "The audio callback never blocks" => sorry;
  "No input crashes the app" => sorry;
  -- needs a failed worker thread: (stronglyImplies (on Record) (allUnless (not stop) (or (on RecordDone) (on RecordFailed)))) with the Recorder allowed to crash
  "A request is answered when its worker thread dies" => sorry;
}
