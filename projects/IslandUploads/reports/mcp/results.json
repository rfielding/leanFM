   "say": "from every state the shards can still converge"
  },
  "mustConverge": {
   "lints": [],
   "reading": "on every path, eventually Synced was just delivered",
   "say": "the shards must converge"
  },
  "noLeak": {
   "lints": [],
   "reading": "on every path, never (LeakA was just delivered or LeakB was just delivered)",
   "say": "no read is allowed that a held concurrent policy denies"
  },
  "noSkip": {
   "lints": [],
   "reading": "on every path, never Missed was just delivered",
   "say": "the feed never skips a readable record"
  },
  "readDuringPartition": {
   "lints": [],
   "reading": "it is possible that eventually ReadB was just delivered",
   "say": "eu can read under the policy it holds"
  },
  "reverseJump": {
   "lints": [],
   "reading": "it is possible that eventually (ImportA3to0 was just delivered and (it is possible that eventually (ImportA2to0 was just delivered and (it is possible that eventually ImportA1to3 was just delivered))))",
   "say": "imports finish in reverse order: the cursor stays at 0, then the last to finish moves it to 3"
  },
  "smallFirst": {
   "lints": [],
   "reading": "on every path, (it is not the case that (DoneB1 was just delivered or DoneB2 was just delivered or DoneB3 was just delivered)) holds until StartS was just delivered (and StartS was just delivered does happen)",
   "say": "a small import starts before any large one finishes"
  },
  "writeInPartition": {
   "lints": [],
   "reading": "it is possible that eventually (Partition was just delivered and (on some path, (it is not the case that Heal was just delivered) holds until CommitA1 was just delivered (and CommitA1 was just delivered does happen)))",
   "say": "a write commits while the islands are apart"
  },
  "xFinishes": {
   "lints": [],
   "reading": "on every path, eventually DoneX was just delivered",
   "say": "it also finishes, without assuming fair delivery"
  },
  "xStarts": {
   "lints": [],
   "reading": "on every path, eventually StartX was just delivered",
   "say": "an import that can succeed gets a lane while others keep failing"
  }
