digraph behavior {
rankdir=LR;
graph [bgcolor="white"];
node [shape=box, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10];
"to_move" [label="Seat to move has the clock"];
"checking" [label="Server checks the person's move"];
"searching" [label="A bot searches for the seat"];
"chosen" [label="Bot result checked"];
"moved" [label="Turn ended exactly once", peripheries=2];
"to_move" -> "checking" [label="PlayMove"];
"checking" -> "moved" [label="MovePlayed"];
"checking" -> "to_move" [label="RequestRejected"];
"to_move" -> "searching" [label="BotTurn"];
"searching" -> "chosen" [label="BotMoveChosen"];
"chosen" -> "moved" [label="BotMovePlayed"];
"searching" -> "moved" [label="TurnTimedOut"];
"to_move" -> "moved" [label="TurnTimedOut"];
"to_move" -> "moved" [label="AutoPassed"];
}
