digraph behavior {
rankdir=LR;
graph [bgcolor="white"];
node [shape=box, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10];
"proposed" [label="Challenge requested"];
"open" [label="Open: seats planned and taken"];
"playing" [label="Playing: turns, autopilot and merges"];
"finished" [label="Finished: result announced", peripheries=2];
"rejected" [label="Challenge rejected without mutation", peripheries=2];
"proposed" -> "open" [label="GameCreated"];
"proposed" -> "rejected" [label="RequestRejected"];
"open" -> "open" [label="SeatPlanSet"];
"open" -> "open" [label="SeatTaken"];
"open" -> "open" [label="SeatLeft"];
"open" -> "playing" [label="GameStarted"];
"playing" -> "playing" [label="MovePlayed"];
"playing" -> "playing" [label="BotMovePlayed"];
"playing" -> "playing" [label="TurnTimedOut"];
"playing" -> "playing" [label="AutoPassed"];
"playing" -> "playing" [label="AutopilotSet"];
"playing" -> "playing" [label="TeamsMerged"];
"playing" -> "finished" [label="GameFinished"];
}
