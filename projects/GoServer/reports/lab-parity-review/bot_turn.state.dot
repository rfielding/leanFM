digraph behavior {
rankdir=LR;
graph [bgcolor="white"];
node [shape=box, fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10];
"dispatching" [label="Turn starts for a bot-controlled seat"];
"searching" [label="Bot searches with a time budget"];
"chosen" [label="Result checked against game, seat and turn revision"];
"played" [label="Move and its search summary published", peripheries=2];
"timed_out" [label="Turn ended by its deadline", peripheries=2];
"dispatching" -> "searching" [label="BotTurn"];
"searching" -> "chosen" [label="BotMoveChosen"];
"chosen" -> "played" [label="BotMovePlayed"];
"searching" -> "timed_out" [label="TurnTimedOut"];
"timed_out" -> "timed_out" [label="BotMoveChosen"];
}
