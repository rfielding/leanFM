/-- The roles. -/
inductive Role where
  | person
  | server
  | bot
  deriving Repr, BEq, DecidableEq

/-- What an event carries: one message of the protocol, or an event a role performs alone. -/
inductive Payload where
  | enterRoom (m : EnterRoom)
  | roomEntered (m : RoomEntered)
  | requestRejected (m : RequestRejected)
  | createRoom (m : CreateRoom)
  | roomCreated (m : RoomCreated)
  | listGames (m : ListGames)
  | gamesListed (m : GamesListed)
  | sendRoomChat (m : SendRoomChat)
  | roomChat (m : RoomChat)
  | createGame (m : CreateGame)
  | gameCreated (m : GameCreated)
  | setSeatPlan (m : SetSeatPlan)
  | seatPlanSet (m : SeatPlanSet)
  | takeSeat (m : TakeSeat)
  | seatTaken (m : SeatTaken)
  | leaveSeat (m : LeaveSeat)
  | seatLeft (m : SeatLeft)
  | startGame (m : StartGame)
  | gameStarted (m : GameStarted)
  | botTurn (m : BotTurn)
  | botMoveChosen (m : BotMoveChosen)
  | playMove (m : PlayMove)
  | movePlayed (m : MovePlayed)
  | setAutopilot (m : SetAutopilot)
  | autopilotSet (m : AutopilotSet)
  | proposeMerge (m : ProposeMerge)
  | mergeProposed (m : MergeProposed)
  | respondMerge (m : RespondMerge)
  | mergeResponded (m : MergeResponded)
  | getGameState (m : GetGameState)
  | gameState (m : GameState)
  | applied
  | stale
  | clockRanOut
  | passed
  | finished
  deriving Repr, BEq

/-- The event envelope (selfhost.session.envelope): ts in nanoseconds, unique in its stream. -/
structure Event where
  ts : Nat
  session : String
  src : Role
  dst : Role
  cause : Option Nat := none
  prev : Option Nat := none
  /-- the sender's clock when it sent and the receiver's when it received, ns (selfhost.session.timelines) -/
  sentAt : Option Nat := none
  receivedAt : Option Nat := none
  payload : Payload
  deriving Repr, BEq

/-! Roles without states here, each with the reason:
* Person: its projection runs branches in parallel (par or join), whose states are not one machine; Lean states are generated for sequential roles
* Server: its projection runs branches in parallel (par or join), whose states are not one machine; Lean states are generated for sequential roles
-/

/-! Bot: its states, the typestate states of its projection. -/
namespace Bot

inductive State where
  | s0
  | s1
  | s2
  | s3
  | done
  deriving Repr, BEq, DecidableEq

def start : State := .s0

/-- The step an event takes Bot from a state, where the protocol allows it. -/
def step : State -> Event -> Option State
  | .s0, { src := .server, dst := .bot, payload := .botTurn _, .. } => some .s3
  | .s1, { src := .server, dst := .bot, payload := .botTurn _, .. } => some .s3
  | .s2, { src := .server, dst := .bot, payload := .botTurn _, .. } => some .s3
  | .s3, { src := .bot, dst := .server, payload := .botMoveChosen _, .. } => some .s2
  | _, _ => none

/-- Whether the session may end here. -/
def final : State -> Bool
  | .s0 => true
  | .s1 => true
  | .s2 => true
  | .done => true
  | _ => false

/-- The events Bot takes part in. -/
def involves (e : Event) : Bool := e.src == .bot || e.dst == .bot

/-- Whether one session's events, in order, are a complete run of Bot. -/
def accepts (evs : List Event) : Bool :=
  match (evs.filter involves).foldlM step start with
  | some s => final s
  | none => false

end Bot

end GoServer
