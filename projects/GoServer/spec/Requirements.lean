      {name := "chat never pins to a position that does not exist", task := "game_chat", mode := .never, probability := none, predicate := "a chat message is pinned to a position the game or its review tree does not have, or to a move not yet played, or a pinned message appears on a line that does not pass through its position"},
      {name := "analysis never leaks into the game", task := "game_state", mode := .never, probability := none, predicate := "a local variation or local search result is sent to the server or shown as an actual move; or a person seated in a game in play can create variations or run local search on it in the provided browser"},
      {name := "pointer preview never misleads", task := "game_state", mode := .never, probability := none, predicate := "the pointer preview shows a stone where a click would be refused (an occupied point, a ko or superko violation, another seat's turn, a finished position, or a position where analysis is closed to the viewer), or the preview sends anything to the server"},
      {name := "games never stall", task := "game_lifecycle", mode := .never, probability := none, predicate := "a started game has no seat to move and is not finished, or a finished game accepts moves, seat changes or merges"},
      {name := "sign_in never lets anyone borrow a claimed name", task := "sign_in", mode := .never, probability := none, predicate := "a claimed name, or a name equal to it ignoring case, gets a session without the correct password; a person gets a name beginning bot-; a wrong password changes anything but that name's failure count; repeated wrong passwords for one name are answered at full speed (after 5 consecutive failures each further attempt waits a doubling delay up to 15 minutes); password hashing runs more than 2 at a time; the password or its hash appears in a response, a log, the replay cache, a URL or the page"},
      {name := "claim_name never takes another name", task := "claim_name", mode := .never, probability := none, predicate := "a claimed name is claimed again or its password replaced through a claim, a name equal ignoring case to a claimed name is claimed, a name in use by someone's live session is claimed, a bot- name is claimed, a password shorter than 8 or longer than 128 bytes is accepted, more than 1000 names are claimed, or a claim is acknowledged before it is durable"},
      {name := "change_password never works without the current password", task := "change_password", mode := .never, probability := none, predicate := "a password changes without the current one, wrong current passwords escape the sign-in throttle, a session that predates the change survives it, a name changes its password more than once a minute, more than 20,000 account records (claims, password changes, releases) are written in all, or a change is acknowledged before it is durable"},
      {name := "release_name never frees a name without its password", task := "release_name", mode := .never, probability := none, predicate := "a name is released without its current password or confirmation, wrong passwords escape the sign-in throttle, a session for the released name survives, a later claim of the name inherits the released claim's rated games or ratings, or a release is acknowledged before it is durable"},
      {name := "ranking never counts what it should not", task := "ranking", mode := .never, probability := none, predicate := "an unclaimed seat, an autopilot seat, a seat whose name was claimed after the game started, a game still in play or a single-team game changes a rating; one game counts twice, including across a restart; the ratings depend on the order in which games finished; or an unclaimed person appears in the listing"},
      {name := "the data file never escapes or corrupts", task := "ranking", mode := .never, probability := none, predicate := "the data file or its directory is a symlink or resolves outside the project root when defaulted; it is served over HTTP; it grows past 100,000 results or 1000 claims; a crash mid-write damages an earlier record; or a damaged record other than a torn final line lets the server start with part of the history"}
    ]
  , performance := [], charts := []
  , desiredOutputs := (scenarios.flatMap fun (id, title, _, _, _) => viewOutputs id title) ++ (customTasks.flatMap fun t => viewOutputs t.id t.title) ++ [
      {id := "game.score_timeline", prompt := "Show the MCTS estimations like the N-Player Go Lab", question := "How did each seat's projected final score evolve along the viewed line?", kind := .function2d, eventSource := "BotMovePlayed search summaries in GameState.moves, plus the viewer's own local searches", reducer := "for each move on the viewed line, the projected final score per seat from the search at that position, or the parent search's statistics for that move; gaps where no search exists", unit := "points per seat against move number"},
      {id := "game.session_type", prompt := "let's show the session type for the game in a hidden panel", question := "What is the session type of GoServer: who sends which message to whom, in which order, and where the choices, loops and independent sessions are?", kind := .function2d, eventSource := "spec/Session.lean, the regions from --@begin Rooms to --@end GoServer", reducer := "LeanFM SessionTools.parseProtocol of those regions without doc comments, then annotatedModel drawn as SVG in the dark theme (spec/SessionPanel.lean)", unit := "messages and local events on the Person, Server and Bot lifelines"},
      {id := "game.result", prompt := "Teams to let users merge together", question := "Which team won, by how much?", kind := .scalar, eventSource := "GameFinished and the final GameState", reducer := "team score = sum of members' territory minus sum of members' losses; highest team score wins", unit := "points"}]
  , markdown := [
      {id := "scope", title := "Current slice", body := "Named chat rooms, room challenge listings, watch/join, room chat and isolated game chat; N-player Go modelled on the stakeholder's N-Player Go Lab: per-seat bot/person control planned by the creator, autopilot for seated people, preset teams and consensual permanent merges, server-side max-n Monte Carlo tree search bots with published search summaries, timed turns, scoring with per-capturer bowls, and a Lab-style browser with history, variations, local analysis, projected-score timeline, sounds and GIF export. Claimed names with passwords and a ranking of claimed names and bots from rated games are included and durable. Handicaps, other persistence, SGF export, push transport and moderation administration are deferred."},
      {id := "rules", title := "N-player Go rules", body := "Two to eight seats on a 5, 7, 9, 11, 13 or 19 line board bounded by a Wall. Seats take turns in order. After a stone is placed every adjacent group of another colour with no liberty is removed and counted as that owner's losses (its bowl records which seat captured it); if nothing was captured and the placed group has no liberty it is removed as suicide and counted as the mover's losses. Suicide is legal. Territory is an empty region bordered only by one colour's stones and the Wall. Seat score = Territory - Losses; team score is the sum over its members. With the ko rule on, simple ko plus situational superko forbid a stone that recreates an earlier board with the same seat to move, compared exactly rather than by hash alone; passes, timeouts and resignations are never rejected for repetition; Auto turns the rule on only for two seats. Every seat plays on a byo-yomi clock: main time, then periods of equal length; a move within a period keeps it, each period run over is used up, and when the last runs over the turn is a timeout and the seat keeps one period for later turns. A timeout neither ends nor resets the passing round; a full round of timeouts abandons the game, scored as it stands. The game ends when every remaining seat has passed since the last stone, or at 3*N*N moves. A resigned seat passes automatically. The winners are the team or teams with the highest team score among teams with at least one member who has not resigned."},
      {id := "params", title := "Challenge parameters and defaults", body := "board_size 5/7/9/11/13/19, default 11; seats 2-8, default 4; main_time_ms 60,000, 300,000 (default, five minutes), 600,000, 1,200,000, 1,800,000 or 3,600,000; byoyomi_periods 1, 3, 5 (default) or 10; byoyomi_ms 10,000, 20,000, 30,000 (default) or 60,000; the same clock applies to every seat, person or bot; ko_rule 0 Auto (default), 1 Off, 2 simple ko plus situational superko; explore_milli (UCT exploration constant x1000) 500, 700 (default), 1000 or 1400; reward_mode margin (soft margin against the best rival, default), win (win or shared win) or rank; softness 2, 4 (default) or 8 points for the margin reward. Zero or empty means the default. seat_plan lists, per seat, controller bot or open (default open) and team (default its own seat number)."},
      {id := "seats", title := "Seat control", body := "The creator plans every seat before the start as bot or open and assigns teams; people in the room open the challenge and take open seats or leave them. StartGame turns every seat still without a person into a bot named bot-<seat>. While playing, the person in a seat can switch autopilot on (a server bot plays the seat on its own clock with published search) and off; the seat remains theirs. Nobody can move for another person's seat, and no client can submit a bot's move."},
      {id := "teams", title := "Teams and merges", body := "Teams are numbered; a seat's planned team defaults to its seat number, so everyone plays alone unless the creator groups seats. During play, a seated person proposes merging their team with another; both teams must contain at least one seated person; every person seated in either team must accept; any decline withdraws it. Merges are permanent and adopt the smaller team number. Bots on a team search for the team's combined score. Pending proposals, acceptances and the people still to answer are visible to every game member."},
      {id := "analysis", title := "History, variations and local analysis", body := "Every viewer can step through the actual moves. Variations and the viewer's own Monte Carlo searches run in the browser with the same rules engine as the Lab, are never sent to the server, and vanish when the page closes. Watchers may branch and search at any time; a person seated in a game in play may only browse the actual moves until the game finishes. Each bot move publishes its search summary when it is played: candidates with visit share and reward, and per seat the projected final score (Proj.) and outlook. The projected-score timeline uses those summaries and the viewer's local searches."},
      {id := "identity", title := "Identity and navigation boundaries", body := "IssueSession gives a server-issued session for a name; a claimed name needs its password (see Claimed names and ranking); there is no other account registration and no provider API credential. EnterRoom authorizes room membership; JoinGame authorizes game chat membership within that room. Creator and sender are server-derived identities, never trusted request fields. Watch/join both enter a chat container and grant no gameplay authority."},
      {id := "bounds", title := "Bounded observable inputs and overload", body := "Room names trim surrounding whitespace, are unique case-sensitive display identifiers and are never interpreted as paths or markup. At most 16 rooms exist including the lobby, and at most 64 challenges exist per room. All state except claims and rated game results is in memory and resets on restart. Names are nonempty UTF-8 up to 128 characters; chat bodies are nonempty UTF-8 up to 4000 characters; each room retains its latest 100 chat entries and each game its latest 500. The 100 Person instances are a first-slice capacity forecast, not measured throughput. Full queues reject with a busy result without mutation; the separate implementation mapping must bound connections and enforce the actor resource contracts."},
      {id := "correlation", title := "Correlation, replay and failure", body := "Request IDs are unique per authenticated session and task. Each request produces exactly one success or RequestRejected with the same request_id. Duplicate mutation IDs return the prior result, and conflicting reuse with another body is rejected. Structured game listings retain their GameListed record fields. Scenario trace envelopes must retain event identity, session/task and cause_id independently of prior ordering; HTTP conversion, runtime and storage choices await the separate mapping."},
      {id := "claims", title := "Claimed names and ranking", body := "Everything about a name happens on the sign-in form: a name alone signs in as a guest under an unclaimed name; a name with its password signs in to a claimed name (and replaces an older session for it); a name nobody has claimed with a new password typed twice claims it; a claimed name with its current password once and a new password twice changes the password and ends every other session for the name. Signing out frees a guest's name so it can be claimed. Change password and Release name sit in a panel of the form that stays closed until opened; releasing needs the password and a confirmation, ends every session for the name, and removes it from the ranking, while the games it played still count for the other players. Claims are compared ignoring letter case, so Alice and alice cannot both exist as claimed names. Names beginning bot- belong to bots. The server keeps a salted PBKDF2-SHA256 hash, never the password, and slows down repeated wrong guesses. The ranking is computed from rated games only: games whose seats on at least two teams are held by bots or by names claimed before the game started (a seat that ever ran on autopilot is not rated). It is a Bradley-Terry fit, so it never depends on the order of games and recomputing it from the recorded results always gives the same numbers; one win and one loss against a fixed 1500 anchor keep a player with few games near 1500. Bots are rated per search setting, so beating a stronger setting counts for more. Claims and rated results are the only state that survives a restart."},
      {id := "validation", title := "Meaning of this check", body := "The checker establishes Lean elaboration, protobuf agreement, structural completeness and current-spec diagram provenance. It does not prove that the deployed server satisfies the temporal, isolation, concurrency, resource or security obligations; those are mapped to controls and negative tests by the separate implementation specification."}
    ] }
end Project.Requirements
