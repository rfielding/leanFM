def scenarios : List (String × String × String × String × String) := [
  ("create_room", "Create a named chat room", "CreateRoom", "RoomCreated", "A valid session creates one public room whose identifier is its trimmed, nonempty UTF-8 name of at most 128 characters; duplicate names, invalid input and the 16-room capacity limit reject without mutation; the creator then uses EnterRoom to enter it")
, ("list_rooms", "List the available chat rooms", "ListRooms", "RoomsListed", "A valid server-issued session returns only visible room identifiers")
, ("enter_room", "Enter a room and inspect its game list", "EnterRoom", "RoomEntered", "The caller enters an existing visible room; the response names that room and its own game identifiers")
, ("list_games", "List room games and open challenges", "ListGames", "GamesListed", "A room member receives only game/challenge metadata belonging to that room, including each challenge name, server-issued ID, creator and open status")
, ("join_game", "Watch or enter a game chat container", "JoinGame", "GameJoined", "An authorized room member enters the selected game; repeated entry is idempotent and does not grant gameplay authority")
, ("room_chat", "Send room chat", "SendRoomChat", "RoomChat", "A room member sends bounded text to that room only; sender and timestamp are assigned by the server")
, ("game_chat", "Send game chat", "SendGameChat", "GameChat", "A game member sends bounded text to that game only; no implicit copy is added to the parent room chat")
, ("create_game", "Create a challenge with board, bot and seat settings", "CreateGame", "GameCreated", "A room member creates one open challenge with a bounded name, a server-issued ID, validated board parameters, bot search settings and an optional seat plan (bot or open, and team, per seat); the result and later listings retain them")
, ("set_seat_plan", "Plan a seat as bot or open and set its team", "SetSeatPlan", "SeatPlanSet", "Before the start, the creator marks one seat as played by a bot or open for a person, and sets its team")
, ("take_seat", "Take an open seat", "TakeSeat", "SeatTaken", "A member of the game and its room takes one empty seat planned as open (or the first such seat) before the start; one seat per person per game")
, ("leave_seat", "Leave a seat before the start", "LeaveSeat", "SeatLeft", "A seated person leaves their seat before the start; it becomes open again")
, ("start_game", "Start a game; bots fill the remaining seats", "StartGame", "GameStarted", "Only the creator starts an open game; every seat without a person is played by a server-side search bot and seat 1 moves first")
, ("set_autopilot", "Hand my seat to a bot, or take it back", "SetAutopilot", "AutopilotSet", "A seated person lets a server bot play their seat (autopilot) or takes it back; the seat stays theirs")
, ("play_move", "Play a stone, pass or resign", "PlayMove", "MovePlayed", "The person controlling the seat to move plays a legal stone, a pass or a resignation at the current move number before the seat's clock runs out")
, ("propose_merge", "Propose merging two teams", "ProposeMerge", "MergeProposed", "A seated person proposes merging their team with another team during play")
, ("respond_merge", "Accept or decline a merge proposal", "RespondMerge", "MergeResponded", "A person seated in either team of a pending proposal accepts or declines it")
, ("game_state", "Watch the board, clocks, scores, teams and record", "GetGameState", "GameState", "A game member reads the authoritative position, seats, teams, proposals, clock and the move record from a given move number, including the search summary of each bot move")
, ("sign_in", "Enter a name, with its password if it is claimed", "IssueSession", "SessionIssued", "A person enters a name and receives a fresh session; a claimed name also needs its password")
, ("claim_name", "Claim a name: enter it with a password typed twice", "ClaimName", "NameClaimed", "On the sign-in form a person enters a name nobody has claimed and a new password typed twice; the name becomes theirs and they are signed in")
, ("change_password", "Change my password: the old one once, the new one twice", "ChangePassword", "PasswordChanged", "On the sign-in form a person enters a claimed name, its current password once and a new password twice; the new password replaces the old and they are signed in")
, ("sign_out", "Sign out and return to the sign-in form", "SignOut", "SignedOut", "A signed-in person ends their session; an unclaimed name becomes free again")
, ("release_name", "Release my claimed name", "ReleaseName", "NameReleased", "From a panel on the sign-in form that opens on request, a person enters a claimed name and its password and confirms; the name becomes free and leaves the ranking")
, ("review_move", "Add a move to a finished game's shared review tree", "AddReviewMove", "ReviewMoveAdded", "After the game finishes, a game member adds a stone or a pass after any position of the game or of its review tree; the server keeps it and every game member sees it")
, ("ranking", "See the ranking of claimed names and bots", "GetRanking", "RankingListed", "Anyone with a session reads the ranking computed from the rated games: claimed names and bots ordered by rating")
]
def taskFor (id title request response : String) : TaskRequirement :=
  { id, title, actors := ["Person", "Server"], initialState := "ready"
  , states := [{id := "ready", label := "Ready", group := "client", markdown := "Request not yet issued", terminal := false},
               {id := "checking", label := "Server checks identity, scope and bounds", group := "server", markdown := "No mutation is committed before validation", terminal := false},
               {id := "accepted", label := "Correlated result", group := "terminal", markdown := "One authoritative result", terminal := true},
               {id := "rejected", label := "Explicit rejection without mutation", group := "terminal", markdown := "No private state is echoed", terminal := true}]
  , transitions := [{src := "ready", dst := "checking", message := request, probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "accepted", message := response, probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "rejected", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }

def event (task src dst message : String) : GrammarExpr := .event {task, src, dst, message}
def ev := event
def task_bot_turn : TaskRequirement :=
  { id := "bot_turn", title := "A server bot plays one turn", actors := ["Server", "Bot", "Person"], initialState := "dispatching"
  , states := [{id := "dispatching", label := "Turn starts for a bot-controlled seat", group := "server", markdown := "Position and history are copied for the search", terminal := false},
               {id := "searching", label := "Bot searches with a time budget", group := "bot", markdown := "Max-n Monte Carlo tree search outside the game lock", terminal := false},
               {id := "chosen", label := "Result checked against game, seat and turn revision", group := "server", markdown := "Illegal or stale results become a pass or are discarded", terminal := false},
               {id := "played", label := "Move and its search summary published", group := "terminal", markdown := "Visible to every game member", terminal := true},
               {id := "timed_out", label := "Turn ended when the seat's clock ran out", group := "terminal", markdown := "A late result is discarded", terminal := true}]
  , transitions := [{src := "dispatching", dst := "searching", message := "BotTurn", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "chosen", message := "BotMoveChosen", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "chosen", dst := "played", message := "BotMovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "timed_out", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "timed_out", dst := "timed_out", message := "BotMoveChosen", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
def task_turn : TaskRequirement :=
  { id := "turn", title := "One turn of a started game", actors := ["Person", "Server", "Bot"], initialState := "to_move"
  , states := [{id := "to_move", label := "Seat to move has the clock", group := "server", markdown := "Controlled by a person, a bot, or autopilot", terminal := false},
               {id := "checking", label := "Server checks the person's move", group := "server", markdown := "Seat, move number, clock, legality and superko", terminal := false},
               {id := "searching", label := "A bot searches for the seat", group := "bot", markdown := "Bot seats and autopilot seats", terminal := false},
               {id := "chosen", label := "Bot result checked", group := "server", markdown := "Bound to game, seat and turn revision", terminal := false},
               {id := "moved", label := "Turn ended exactly once", group := "terminal", markdown := "Next seat to move, or the game finishes", terminal := true}]
  , transitions := [{src := "to_move", dst := "checking", message := "PlayMove", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "moved", message := "MovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "checking", dst := "to_move", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "to_move", dst := "searching", message := "BotTurn", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "chosen", message := "BotMoveChosen", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "chosen", dst := "moved", message := "BotMovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "searching", dst := "moved", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "to_move", dst := "moved", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "to_move", dst := "moved", message := "AutoPassed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
def task_team_merge : TaskRequirement :=
  { id := "team_merge", title := "Two teams merge by consent", actors := ["Person", "Server"], initialState := "idle"
  , states := [{id := "idle", label := "No proposal between these teams", group := "client", markdown := "Teams as planned or previously merged", terminal := false},
               {id := "proposing", label := "Server checks the proposal", group := "server", markdown := "Proposer seated; both teams contain a person", terminal := false},
               {id := "pending", label := "Waiting for every person in both teams", group := "server", markdown := "Acceptances recorded per person", terminal := false},
               {id := "responding", label := "Server records one response", group := "server", markdown := "Only persons seated in either team respond", terminal := false},
               {id := "merged", label := "Teams merged permanently", group := "terminal", markdown := "Scores and bot rewards use the merged team", terminal := true},
               {id := "withdrawn", label := "Proposal withdrawn", group := "terminal", markdown := "Declined, game finished, or a team changed", terminal := true},
               {id := "rejected", label := "Proposal rejected without mutation", group := "terminal", markdown := "No proposal recorded", terminal := true}]
  , transitions := [{src := "idle", dst := "proposing", message := "ProposeMerge", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "proposing", dst := "pending", message := "MergeProposed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "proposing", dst := "rejected", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "pending", dst := "responding", message := "RespondMerge", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "responding", dst := "pending", message := "MergeResponded", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "responding", dst := "pending", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "pending", dst := "merged", message := "TeamsMerged", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "pending", dst := "withdrawn", message := "MergeWithdrawn", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
def task_game_lifecycle : TaskRequirement :=
  { id := "game_lifecycle", title := "A game from challenge to result", actors := ["Person", "Server"], initialState := "proposed"
  , states := [{id := "proposed", label := "Challenge requested", group := "client", markdown := "CreateGame sent", terminal := false},
               {id := "open", label := "Open: seats planned and taken", group := "server", markdown := "Creator plans seats; people take or leave open seats", terminal := false},
               {id := "playing", label := "Playing: turns, autopilot and merges", group := "server", markdown := "Every turn ends exactly once", terminal := false},
               {id := "finished", label := "Finished: result announced", group := "terminal", markdown := "Board, record and summaries remain readable", terminal := true},
               {id := "rejected", label := "Challenge rejected without mutation", group := "terminal", markdown := "No game created", terminal := true}]
  , transitions := [{src := "proposed", dst := "open", message := "GameCreated", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "proposed", dst := "rejected", message := "RequestRejected", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatPlanSet", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatTaken", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "open", message := "SeatLeft", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "open", dst := "playing", message := "GameStarted", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "MovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "BotMovePlayed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "TurnTimedOut", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "AutoPassed", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "AutopilotSet", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "playing", message := "TeamsMerged", probabilityNum := 1, probabilityDen := 1, dwellMs := 0},
                    {src := "playing", dst := "finished", message := "GameFinished", probabilityNum := 1, probabilityDen := 1, dwellMs := 0}] }
def customTasks : List TaskRequirement := [task_bot_turn, task_turn, task_team_merge, task_game_lifecycle]
def customGrammars : List TaskGrammar := [
  {task := "bot_turn", entry := "dispatching", terminals := ["played", "timed_out"], body := .seq (ev "bot_turn" "Server" "Bot" "BotTurn") (.choice [.seq (ev "bot_turn" "Bot" "Server" "BotMoveChosen") (ev "bot_turn" "Server" "Person" "BotMovePlayed"), .seq (ev "bot_turn" "Server" "Person" "TurnTimedOut") (GrammarExpr.optional (ev "bot_turn" "Bot" "Server" "BotMoveChosen"))])},
  {task := "turn", entry := "to_move", terminals := ["moved"], body := .choice [GrammarExpr.ref "play_move", GrammarExpr.ref "bot_turn", ev "turn" "Server" "Person" "TurnTimedOut", ev "turn" "Server" "Person" "AutoPassed"]},
  {task := "team_merge", entry := "idle", terminals := ["merged", "withdrawn", "rejected"], body := .seq (ev "team_merge" "Person" "Server" "ProposeMerge") (.choice [.seq (ev "team_merge" "Server" "Person" "MergeProposed") (.seq (GrammarExpr.star (.seq (ev "team_merge" "Person" "Server" "RespondMerge") (.choice [ev "team_merge" "Server" "Person" "MergeResponded", ev "team_merge" "Server" "Person" "RequestRejected"]))) (.choice [ev "team_merge" "Server" "Person" "TeamsMerged", ev "team_merge" "Server" "Person" "MergeWithdrawn"])), ev "team_merge" "Server" "Person" "RequestRejected"])},
  {task := "game_lifecycle", entry := "proposed", terminals := ["finished", "rejected"], body := GrammarExpr.seqList [GrammarExpr.ref "create_game", GrammarExpr.star (.choice [GrammarExpr.ref "set_seat_plan", GrammarExpr.ref "take_seat", GrammarExpr.ref "leave_seat", GrammarExpr.ref "join_game", GrammarExpr.ref "game_chat", GrammarExpr.ref "game_state"]), GrammarExpr.ref "start_game", GrammarExpr.star (.choice [GrammarExpr.ref "turn", GrammarExpr.ref "set_autopilot", GrammarExpr.ref "team_merge", GrammarExpr.ref "game_chat", GrammarExpr.ref "game_state"]), ev "game_lifecycle" "Server" "Person" "GameFinished", GrammarExpr.star (.choice [GrammarExpr.ref "game_state", GrammarExpr.ref "game_chat"])]}
]
def customProcesses : List RequirementProcess := [
  {actor := "Server", task := "bot_turn", states := ["dispatching", "searching", "chosen", "played", "timed_out"], sends := ["BotTurn", "BotMovePlayed", "TurnTimedOut"], receives := ["BotMoveChosen"]},
  {actor := "Bot", task := "bot_turn", states := ["dispatching", "searching", "chosen", "timed_out"], sends := ["BotMoveChosen"], receives := ["BotTurn"]},
  {actor := "Person", task := "bot_turn", states := ["searching", "played", "timed_out"], sends := [], receives := ["BotMovePlayed", "TurnTimedOut"]},
  {actor := "Person", task := "turn", states := ["to_move", "checking", "moved"], sends := ["PlayMove"], receives := ["MovePlayed", "RequestRejected", "BotMovePlayed", "TurnTimedOut", "AutoPassed"]},
  {actor := "Server", task := "turn", states := ["to_move", "checking", "searching", "chosen", "moved"], sends := ["MovePlayed", "RequestRejected", "BotTurn", "BotMovePlayed", "TurnTimedOut", "AutoPassed"], receives := ["PlayMove", "BotMoveChosen"]},
  {actor := "Bot", task := "turn", states := ["to_move", "searching", "chosen"], sends := ["BotMoveChosen"], receives := ["BotTurn"]},
  {actor := "Person", task := "team_merge", states := ["idle", "proposing", "pending", "responding", "merged", "withdrawn", "rejected"], sends := ["ProposeMerge", "RespondMerge"], receives := ["MergeProposed", "MergeResponded", "RequestRejected", "TeamsMerged", "MergeWithdrawn"]},
  {actor := "Server", task := "team_merge", states := ["idle", "proposing", "pending", "responding", "merged", "withdrawn", "rejected"], sends := ["MergeProposed", "MergeResponded", "RequestRejected", "TeamsMerged", "MergeWithdrawn"], receives := ["ProposeMerge", "RespondMerge"]},
  {actor := "Person", task := "game_lifecycle", states := ["proposed", "open", "playing", "finished", "rejected"], sends := [], receives := ["GameCreated", "RequestRejected", "SeatPlanSet", "SeatTaken", "SeatLeft", "GameStarted", "MovePlayed", "BotMovePlayed", "TurnTimedOut", "AutoPassed", "AutopilotSet", "TeamsMerged", "GameFinished"]},
  {actor := "Server", task := "game_lifecycle", states := ["proposed", "open", "playing", "finished", "rejected"], sends := ["GameCreated", "RequestRejected", "SeatPlanSet", "SeatTaken", "SeatLeft", "GameStarted", "MovePlayed", "BotMovePlayed", "TurnTimedOut", "AutoPassed", "AutopilotSet", "TeamsMerged", "GameFinished"], receives := []}
]
def viewOutputs (id title : String) : List DesiredOutput :=
  [{id := id ++ ".interaction", prompt := "Make the game behave like the N-Player Go Lab, with selectable bots, teams, history and MCTS estimates", question := "Which messages realize: " ++ title ++ "?", kind := .interactionDiagram, eventSource := id ++ " grammar in the current Project.Requirements.requirements", reducer := "render this current task grammar, preserving every branch", unit := "messages in one scenario"},
   {id := id ++ ".state", prompt := "Make the game behave like the N-Player Go Lab, with selectable bots, teams, history and MCTS estimates", question := "Which states and transitions realize: " ++ title ++ "?", kind := .stateMachine, eventSource := id ++ " task in the current Project.Requirements.requirements", reducer := "render the same specification's task states and message transitions", unit := "states/transitions in one scenario"}]
def requirements : RequirementSpec :=
  { id := "goserver", title := "GoServer: rooms, chat and N-player Go with bots, teams, history and search estimates"
  , actors := ["Person", "Server", "Bot"]
  , actorPopulations := [{actorSpec := "Person", instancePrefix := "person", count := 100, routing := .sticky "session_id"}, {actorSpec := "Server", instancePrefix := "server", count := 1, routing := .roundRobin}, {actorSpec := "Bot", instancePrefix := "bot-slot", count := 8, routing := .roundRobin}]
  , actorResources := [{actor := "Person", inboundCapacity := 64, outboundCapacity := 64, maxInFlight := 8, memoryBudgetBytes := 16777216}, {actor := "Server", inboundCapacity := 4096, outboundCapacity := 4096, maxInFlight := 1024, memoryBudgetBytes := 536870912}, {actor := "Bot", inboundCapacity := 64, outboundCapacity := 1, maxInFlight := 1, memoryBudgetBytes := 268435456}]
  , actorReliability := [], reliabilityGates := [], actorCosts := [], messages
  , tasks := (scenarios.map fun (id, title, request, response, _) => taskFor id title request response) ++ customTasks
  , grammars := (scenarios.map fun (id, _, request, response, _) => {task := id, entry := "ready", terminals := ["accepted", "rejected"], body := .seq (event id "Person" "Server" request) (.choice [event id "Server" "Person" response, event id "Server" "Person" "RequestRejected"]) }) ++ customGrammars
  , processes := (scenarios.flatMap fun (id, _, request, response, _) => [{actor := "Person", task := id, states := ["ready", "checking", "accepted", "rejected"], sends := [request], receives := [response, "RequestRejected"]}, {actor := "Server", task := id, states := ["ready", "checking", "accepted", "rejected"], sends := [response, "RequestRejected"], receives := [request]}]) ++ customProcesses
  , properties := [
      {name := "create_room authorized correlated result", task := "create_room", mode := .always, probability := none, expression := "A valid session creates one public room whose identifier is its trimmed, nonempty UTF-8 name of at most 128 characters; duplicate names, invalid input and the 16-room capacity limit reject without mutation; every result retains its request_id and task/session boundary"},
      {name := "list_rooms authorized correlated result", task := "list_rooms", mode := .always, probability := none, expression := "A valid server-issued session returns only visible room identifiers; every result retains its request_id and task/session boundary"},
      {name := "enter_room authorized correlated result", task := "enter_room", mode := .always, probability := none, expression := "The caller enters an existing visible room and receives that room and its game identifiers; every result retains its request_id and task/session boundary"},
      {name := "list_games authorized correlated result", task := "list_games", mode := .always, probability := none, expression := "A room member receives only metadata belonging to that room, including challenge name, server-issued ID, creator and open status"},
      {name := "join_game authorized correlated result", task := "join_game", mode := .always, probability := none, expression := "An authorized room member enters the selected game idempotently without receiving gameplay authority"},
      {name := "room_chat authorized correlated result", task := "room_chat", mode := .always, probability := none, expression := "A room member sends bounded text to that room only; sender and timestamp are server-assigned"},
      {name := "game_chat authorized correlated result", task := "game_chat", mode := .always, probability := none, expression := "A game member sends bounded text to that game only, with no implicit copy to parent room chat"},
      {name := "post-game review is shared and remembered", task := "review_move", mode := .always, probability := none, expression := "Once a game has finished, every move a game member plays in a variation (a stone or a pass for the seat to move, by click, the P key, the Pass button or the C key) is sent to the server, checked against the rules from the position it follows, kept for as long as the game exists, and delivered to every game member in GameState; the same move after the same position is one node; reloading the page loses nothing; local searches stay in the browser"},
      {name := "chat follows the tree", task := "game_chat", mode := .always, probability := none, expression := "Every game chat message is pinned to a position: the position the sender was viewing when it is a position of the game (m<k>, after k actual moves, at most the moves played so far) or, after the finish, of the review tree (r<n>); otherwise the latest actual position; the Chat panel shows the messages pinned to the positions on the line from the empty board to the position being viewed, in the order of that line, so stepping back hides later remarks and stepping into a variation shows its own"},
      {name := "Browser navigation reflects server state", task := "list_rooms", mode := .always, probability := none, expression := "The local browser presents named room creation and entry, room-scoped named challenge creation and entry, and separate room/game chat using actual server results; every room the person has open is a tab, with a further tab for finding and creating rooms, and inside a room the Lobby (room conversation, challenge list, new challenge) is the first tab and every open game has its own tab; open tabs stay alive in the background, keep their variations and analysis, survive a reload of the page, and show a badge when a room has unread messages or a game waits for the viewer's move or merge answer; pending actions and explicit errors remain visible; every enabled navigation control reaches a supported action; each tab shows only results requested for its own room or game; when the server no longer knows the session (it keeps sessions in memory, so a restart forgets them) the page returns to the name form prefilled with the previous name and says why, instead of leaving a page that cannot act; all text is light on a dark background, never dark on a light fill, so it stays readable under dark-mode browser extensions"},
      {name := "create_game authorized correlated result", task := "create_game", mode := .always, probability := none, expression := "A room member creates one fresh named open challenge with a server-issued ID; board size, seat count, byo-yomi clock (main time, number of periods, period length), ko rule, bot settings and seat plan are validated, defaulted when zero, and retained in results and listings"},
      {name := "set_seat_plan creator controls the plan", task := "set_seat_plan", mode := .always, probability := none, expression := "Before the start, only the creator sets a seat's controller to bot or open and its team number (1 to seat count); a seat planned bot cannot be taken; setting a seat held by a person to bot first requires that person to leave"},
      {name := "take_seat authorized correlated result", task := "take_seat", mode := .always, probability := none, expression := "Each open seat holds at most one person, each person holds at most one seat per game, and seats change only before StartGame"},
      {name := "leave_seat before start", task := "leave_seat", mode := .always, probability := none, expression := "Before the start a seated person may leave; the seat becomes open with its planned team"},
      {name := "start_game fills seats with bots", task := "start_game", mode := .always, probability := none, expression := "After GameStarted every seat is controlled by exactly one person or one server-side bot, teams are as planned, the board is empty, nobody has losses, and seat 1 is to move"},
      {name := "set_autopilot keeps the seat", task := "set_autopilot", mode := .always, probability := none, expression := "A seated person may hand their seat to a bot (autopilot) and take it back at any time while playing; the seat, team and player name stay theirs; autopilot moves are played on the seat's own byo-yomi clock and publish search summaries; switching either way never resets the clock; taking it back during their own turn discards the pending bot result and leaves the person whatever the seat's clock still holds for that turn"},
      {name := "play_move rules", task := "play_move", mode := .always, probability := none, expression := "The board is bounded by a Wall; a placed stone removes every adjacent other-colour group without liberty and adds its stones to that owner's losses, recorded per capturing seat (the bowl); otherwise a placed group without liberty is removed as legal suicide and added to the mover's losses; Territory is an empty region bordered only by one colour and Wall; seat score = Territory - Losses; team score = sum of its members' territory minus sum of their losses; turns rotate through seats in order"},
      {name := "byo-yomi clocks", task := "turn", mode := .always, probability := none, expression := "Every seat, person or bot, has one Japanese byo-yomi clock: main time, then a number of periods of equal length; a turn may use the remaining main time and then the remaining periods; a move made within a period keeps that period, and every period run over is used up; when the last period runs over the turn is a timeout and the seat keeps one period for its later turns; GameState gives every seat's remaining main time and periods and the time left in the current stage for the seat to move"},
      {name := "bots spend time where it matters", task := "bot_turn", mode := .always, probability := none, expression := "A bot plans each move from its own clock: in main time a share of the remaining main time by the moves it still expects to play, and in byo-yomi part of one period; it stops early once the second-best candidate could not overtake the best in the time it has left, at the planned time unless the top two candidates are close, and never later than the end of the main time plus most of one period, so it never uses up a period on purpose; a move with only one candidate takes no search time; each summary says how long was planned and why the search stopped (settled, planned, close call stretched to the limit, or node cap)"},
      {name := "turns always end", task := "turn", mode := .always, probability := none, expression := "AG(to_move implies AF moved): every turn ends exactly once, by a person's move or a bot's move before the seat's clock runs out, a timeout when it runs out, or an automatic pass for a resigned seat"},
      {name := "bot results are bound to their turn", task := "bot_turn", mode := .always, probability := none, expression := "A bot result changes the game only for the game, seat and turn revision it was dispatched for and only before the seat's clock runs out; the published move carries its search summary: playouts, milliseconds, the time the bot planned for the move and why it stopped, the top candidates with visit counts, the mover's expected reward and every seat's projected final score and outlook, and whether the move replaced a pass to clean up dead stones"},
      {name := "merges need every person's consent", task := "team_merge", mode := .always, probability := none, expression := "A proposal names the proposer's team and another team; both teams must contain a seated person; it merges them into one team (the smaller team number) once every person seated in either team accepts; any decline, a change to either team, or the game finishing withdraws it; merges are permanent; bots of merged teams search for the merged team's score"},
      {name := "games always finish", task := "game_lifecycle", mode := .always, probability := none, expression := "AG(playing implies AF finished): the game finishes when every remaining seat has passed since the last stone, after one full round of timeouts, or at 3*N*N moves; GameFinished announces team scores and the winning team or teams in the game chat"},
      {name := "game_state reflects the authoritative game", task := "game_state", mode := .always, probability := none, expression := "GameState reports the current board, territory owner, per-seat controller, team, territory, losses with the per-capturer bowl, score and resignation, team totals, pending merge proposals, seat to move, move number, remaining time and, from since_move on, every move record with victims and bot search summaries; winners are the seats of the team or teams with the highest team score that still have a member who has not resigned"},
      {name := "Lab-style viewer", task := "game_state", mode := .always, probability := none, expression := "The browser presents the N-Player Go Lab experience against server state: board with Wall coordinates, territory squares, last-move and next-move markers; Home/Back/Forward/End by buttons and keys, and up/down (buttons and arrow keys) choosing among the next moves A, B, ... when a position has two or more, which Forward then follows, or else switching to the previous or next sibling variation; a variation tree and next-move chips; a Search panel listing the viewed position's candidates (visit share and reward) with a heat overlay; per-seat Territory, Bowl, Score, Proj. and Outlook and team totals; a clickable projected-score timeline; GIF export of the viewed line; stone, capture and final-ten-seconds sounds with a toggle; a translucent stone in the mover's colour follows the pointer over every point where a click would place a stone (the viewer's own live turn, or a variation where analysis is open to them) and nowhere else; player colours appear as stones on a wood tile so Black and White are never confused on the dark page; an always-visible play bar (whose turn, clock, Pass, Resign, autopilot) sits above tabs for Scores, Search, Seats and Chat and GIF, where Chat shows unread messages and Seats shows a merge awaiting the viewer's answer; it follows live moves while the viewer is at the latest move and otherwise shows that new moves arrived"},
      {name := "session type panel", task := "game_state", mode := .always, probability := none, expression := "Every game tab has a panel, closed until the viewer opens it, that shows the session type of GoServer: the sequence diagram LeanFM draws from the session-type regions of spec/Session.lean, the text it was drawn from, and the question, source, reducer, unit and boundary of the picture; nothing loads until the panel is first opened"},
      {name := "Analysis is local", task := "game_state", mode := .always, probability := none, expression := "Variations made during play and every local Monte Carlo search run in the viewer's browser on a copy of the position, are never sent to the server, never change the game, and are lost when the page closes; after the finish, variation moves become the shared review tree; watchers may branch and search at any time; seated people may browse the actual moves during play and may branch and search once the game has finished; wherever analysis is open, a click on a point, a pass (the P key or the Pass button) or the computer's choice (the C key) plays for whichever seat is to move in the viewed position, as a variation"},
      {name := "propose_merge correlated result", task := "propose_merge", mode := .always, probability := none, expression := "A seated person's proposal to merge their team with another team that contains a seated person is recorded once with a server-issued proposal ID, visible to every game member, or rejected without mutation"},
      {name := "respond_merge correlated result", task := "respond_merge", mode := .always, probability := none, expression := "Each person seated in either team of a pending proposal records one acceptance or a decline; the result reports whether the proposal is still pending, merged or withdrawn"},
      {name := "sign_in honours claims", task := "sign_in", mode := .always, probability := none, expression := "A name alone gives a session when the name is unclaimed and no live session holds it; a claimed name with its password gives a session and ends any older session for the name, while the person keeps their rooms, games and seats; names that differ only in letter case or surrounding spaces are one name for claims; names beginning bot- are reserved for bots"},
      {name := "claim_name binds a password to an unclaimed name", task := "claim_name", mode := .always, probability := none, expression := "A valid name that is unclaimed (ignoring case) and held by no live session, under any case variant, becomes claimed with a password of 8 to 128 bytes, which the browser has the person type twice; the result signs the person in; the claim, its time and a salted slow hash of the password survive a restart; the plaintext password is never stored"},
      {name := "change_password needs the current password", task := "change_password", mode := .always, probability := none, expression := "A claimed name's current password (checked and throttled exactly as at sign-in) and a new password of 8 to 128 bytes, typed twice in the browser, replace the stored hash durably; every older session for the name ends and the person is signed in with a new one; the claim time does not change"},
      {name := "sign_out ends the session", task := "sign_out", mode := .always, probability := none, expression := "SignOut ends the caller's session and nothing else: seats, games and rooms stay with the name, and an unclaimed name may then be entered or claimed again"},
      {name := "release_name frees the name", task := "release_name", mode := .always, probability := none, expression := "A claimed name's password (checked and throttled exactly as at sign-in) and an explicit confirmation release the claim durably; every session for the name ends; the name is unclaimed and may be entered or claimed by anyone; the released claim's rated games stay in the fit for everyone else's ratings but the released claim is no longer listed, and a later claim of the same name starts with no rated games"},
      {name := "ranking is computed from rated games", task := "ranking", mode := .always, probability := none, expression := "A game is rated when it finishes with seats on at least two different teams held by rated players; a rated player is a bot (identified by its search settings) or a person whose name was claimed before the game started and whose seat never ran on autopilot; teams are placed by whether a member has not resigned, then team score, ties sharing a place; every two rated seats on different teams make one comparison (a win, a loss or, when tied, half of each) weighted 1/(|A|*|B|) for team sizes |A| and |B| counted in rated seats; ratings are the Bradley-Terry maximum-likelihood fit over all comparisons plus one win and one loss for every player against a fixed anchor of 1500, on the Elo scale (400 points per factor of 10); the result is independent of the order games finished; RankingListed orders claimed names and bots by rating and gives each one's rated games and first places"},
      {name := "claims and results are durable", task := "ranking", mode := .always, probability := none, expression := "Claims and rated game results are appended to one data file under the project root, each record written whole and flushed before the result is acknowledged; on start the file is replayed; live rooms, games, chat and sessions still reset on restart"}
