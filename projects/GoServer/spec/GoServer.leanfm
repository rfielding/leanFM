/- GoServer's protocols in LeanFM protocol text, with the requirements over them that convert to CTL.

   The structures and protocols below are copied verbatim from
   source/cmd/demo/static/session/goserver.leanfm, keeping only the protocols GoServer (one person's
   part of it) includes and the requirements name; that file is generated by spec/SessionPanel.lean,
   checked for staleness by source/cmd/demo/main_test.go and elaborated by LeanFM's own tests, so a
   requirements block cannot be appended to it. When the protocol there changes, copy it here again.

   Every entry holds under LeanFM's default assumptions: messages arrive in order, none is lost and
   the server and bots do not crash. Actors run until shutdown, so "is answered" inside a loop is the
   weak form: before the conversation can stop, the answer has come. Claims about message contents
   (seat and turn ownership, clocks, consent, passwords) and the entries that need a crash or a lost
   connection are sorry until LeanFM can decide them. -/

structure EnterRoom where
  sessionId : Link String
  roomId : String
  requestId : Nat
  deriving TypeName

structure RoomEntered where
  roomId : String
  gameIds : List String
  requestId : Nat
  deriving TypeName

structure ListGames where
  roomId : String
  sessionId : Link String
  requestId : Nat
  deriving TypeName

structure GameListed where
  gameId : String
  creator : String
  status : String
  gameName : String
  boardSize : Nat
  seats : Nat
  seatsFilled : Nat
  deriving TypeName

structure GamesListed where
  games : List GameListed
  requestId : Nat
  roomId : String
  deriving TypeName

structure JoinGame where
  sessionId : Link String
  gameId : String
  requestId : Nat
  deriving TypeName

structure GameJoined where
  gameId : String
  participants : List String
  requestId : Nat
  deriving TypeName

structure SendRoomChat where
  sessionId : Link String
  roomId : String
  body : String
  requestId : Nat
  deriving TypeName

structure RoomChat where
  roomId : String
  sender : String
  body : String
  timeMs : Int
  requestId : Nat
  deriving TypeName

structure RequestRejected where
  requestId : Nat
  code : String
  task : String
  scopeId : String
  deriving TypeName

structure CreateRoom where
  sessionId : Link String
  roomName : String
  requestId : Nat
  deriving TypeName

structure RoomCreated where
  roomId : String
  requestId : Nat
  deriving TypeName

structure SeatPlan where
  seat : Nat
  controller : String
  team : Nat
  deriving TypeName

structure CreateGame where
  sessionId : Link String
  roomId : String
  gameName : String
  boardSize : Nat
  seats : Nat
  mainTimeMs : Nat
  koRule : Int
  byoyomiMs : Nat
  exploreMilli : Nat
  rewardMode : String
  softness : Nat
  seatPlan : List SeatPlan
  requestId : Nat
  byoyomiPeriods : Nat
  deriving TypeName

structure GameCreated where
  gameId : Fresh String
  roomId : String
  creator : String
  status : String
  requestId : Nat
  gameName : String
  boardSize : Nat
  seats : Nat
  mainTimeMs : Nat
  koRule : Int
  byoyomiMs : Nat
  exploreMilli : Nat
  rewardMode : String
  softness : Nat
  seatPlan : List SeatPlan
  byoyomiPeriods : Nat
  deriving TypeName

structure SetSeatPlan where
  sessionId : Link String
  gameId : Link String
  seat : Nat
  controller : String
  team : Nat
  requestId : Nat
  deriving TypeName

structure SeatPlanSet where
  gameId : Link String
  seat : Nat
  controller : String
  team : Nat
  requestId : Nat
  deriving TypeName

structure TakeSeat where
  sessionId : Link String
  gameId : Link String
  seat : Nat
  requestId : Nat
  deriving TypeName

structure SeatTaken where
  gameId : Link String
  seat : Nat
  requestId : Nat
  deriving TypeName

structure LeaveSeat where
  sessionId : Link String
  gameId : Link String
  requestId : Nat
  deriving TypeName

structure SeatLeft where
  gameId : Link String
  seat : Nat
  requestId : Nat
  deriving TypeName

structure StartGame where
  sessionId : Link String
  gameId : Link String
  requestId : Nat
  deriving TypeName

structure SeatView where
  seat : Nat
  player : String
  controller : String
  team : Nat
  territory : Int
  losses : Int
  score : Int
  resigned : Bool
  lossesBy : List Nat
  mainLeftMs : Nat
  periodsLeft : Nat
  deriving TypeName

structure GameStarted where
  gameId : Link String
  seats : List SeatView
  requestId : Nat
  deriving TypeName

structure SetAutopilot where
  sessionId : Link String
  gameId : Link String
  on : Bool
  requestId : Nat
  deriving TypeName

structure AutopilotSet where
  gameId : Link String
  seat : Nat
  on : Bool
  requestId : Nat
  deriving TypeName

structure PlayMove where
  sessionId : Link String
  gameId : Link String
  moveNo : Nat
  kind : String
  x : Nat
  y : Nat
  requestId : Nat
  deriving TypeName

structure MovePlayed where
  gameId : Link String
  moveNo : Nat
  seat : Nat
  kind : String
  x : Nat
  y : Nat
  captured : Nat
  requestId : Nat
  victims : List Nat
  suicide : Nat
  deriving TypeName

structure ProposeMerge where
  sessionId : Link String
  gameId : Link String
  otherTeam : Nat
  requestId : Nat
  deriving TypeName

structure MergeProposed where
  gameId : Link String
  proposalId : Nat
  teamA : Nat
  teamB : Nat
  requestId : Nat
  deriving TypeName

structure RespondMerge where
  sessionId : Link String
  gameId : Link String
  proposalId : Nat
  accept : Bool
  requestId : Nat
  deriving TypeName

structure MergeResponded where
  gameId : Link String
  proposalId : Nat
  status : String
  requestId : Nat
  deriving TypeName

structure GetGameState where
  sessionId : Link String
  gameId : Link String
  sinceMove : Nat
  requestId : Nat
  sinceReview : Nat
  deriving TypeName

structure TeamView where
  team : Nat
  seats : List Nat
  territory : Int
  losses : Int
  score : Int
  deriving TypeName

structure MergeView where
  proposalId : Nat
  teamA : Nat
  teamB : Nat
  proposer : String
  acceptedBy : List String
  waitingFor : List String
  deriving TypeName

structure Candidate where
  kind : String
  x : Nat
  y : Nat
  visits : Nat
  rewardPermille : Int
  outlookPermille : List Int
  projMilli : List Int
  deriving TypeName

structure SearchSummary where
  playouts : Nat
  ms : Nat
  candidates : List Candidate
  rootProjMilli : List Int
  rootOutlookPermille : List Int
  guard : Bool
  stop : String
  plannedMs : Nat
  deriving TypeName

structure MoveRecord where
  moveNo : Nat
  seat : Nat
  kind : String
  x : Nat
  y : Nat
  captured : Nat
  source : String
  victims : List Nat
  suicide : Nat
  search : SearchSummary
  deriving TypeName

structure ReviewNode where
  id : String
  parent : String
  kind : String
  x : Nat
  y : Nat
  seat : Nat
  author : String
  timeMs : Int
  deriving TypeName

structure GameState where
  gameId : Link String
  gameName : String
  status : String
  creator : String
  boardSize : Nat
  koOn : Bool
  mainTimeMs : Nat
  byoyomiMs : Nat
  moveNo : Nat
  toMove : Nat
  remainingMs : Nat
  cells : List Int
  owner : List Int
  seats : List SeatView
  teams : List TeamView
  proposals : List MergeView
  moves : List MoveRecord
  winners : List Nat
  endReason : String
  exploreMilli : Nat
  rewardMode : String
  softness : Nat
  requestId : Nat
  byoyomiPeriods : Nat
  review : List ReviewNode
  reviewCount : Nat
  deriving TypeName

structure BotTurn where
  gameId : Link String
  turnSeq : Nat
  seat : Nat
  moveNo : Nat
  budgetMs : Nat
  deriving TypeName

structure BotMoveChosen where
  gameId : Link String
  turnSeq : Nat
  kind : String
  x : Nat
  y : Nat
  search : SearchSummary
  deriving TypeName

structure BotMovePlayed where
  gameId : Link String
  record : MoveRecord
  deriving TypeName

structure TurnTimedOut where
  gameId : Link String
  moveNo : Nat
  seat : Nat
  deriving TypeName

structure AutoPassed where
  gameId : Link String
  moveNo : Nat
  seat : Nat
  deriving TypeName

structure TeamsMerged where
  gameId : Link String
  proposalId : Nat
  team : Nat
  seats : List Nat
  deriving TypeName

structure MergeWithdrawn where
  gameId : Link String
  proposalId : Nat
  reason : String
  deriving TypeName

structure IssueSession where
  identity : String
  password : String
  requestId : Nat
  deriving TypeName

structure SessionIssued where
  sessionId : Fresh String
  identity : String
  claimed : Bool
  requestId : Nat
  deriving TypeName

/-- A refused sign-in: a wrong password, a claimed name, or too many attempts (HTTP 401 or 429). -/
structure SignInRefused where
  error : String
  deriving TypeName

structure SignOut where
  sessionId : Link String
  requestId : Nat
  deriving TypeName

structure SignedOut where
  requestId : Nat
  deriving TypeName

structure Applied where deriving TypeName

structure Stale where deriving TypeName

structure ClockRanOut where deriving TypeName

structure Passed where deriving TypeName

structure Finished where deriving TypeName

protocol CreateRoomP (Person, Server) given sessionId {
  q: CreateRoom from Person to Server route "POST /api/create_room";
  choice {
    a: RoomCreated from Server to Person cause q status 200 where a.requestId = q.requestId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

protocol ListGamesP (Person, Server) given sessionId {
  q: ListGames from Person to Server route "POST /api/list_games";
  choice {
    a: GamesListed from Server to Person cause q status 200
       where a.requestId = q.requestId ∧ a.roomId = q.roomId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

protocol RoomChatP (Person, Server) given sessionId {
  q: SendRoomChat from Person to Server route "POST /api/send_room_chat";
  choice {
    a: RoomChat from Server to Person cause q status 200 where a.requestId = q.requestId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

protocol TakeSeatP (Person, Server) given sessionId gameId {
  q: TakeSeat from Person to Server route "POST /api/take_seat";
  choice {
    a: SeatTaken from Server to Person cause q status 200 where a.requestId = q.requestId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

/-- After GameCreated, before the start: the creator plans seats, people take and leave them,
and anyone in the room may watch. The phase ends only when StartGame is accepted; a rejected
StartGame (seats not filled, not the creator) leaves the challenge open. -/
protocol Challenge (Person, Server) given sessionId gameId {
  loop Open {
    choice {
      p: SetSeatPlan from Person to Server route "POST /api/set_seat_plan";
      choice {
        SeatPlanSet from Server to Person cause p status 200;
      } or {
        RequestRejected from Server to Person cause p status 200;
      }
      continue Open;
    } or {
      include TakeSeatP Person Server with sessionId, gameId;
      continue Open;
    } or {
      l: LeaveSeat from Person to Server route "POST /api/leave_seat";
      choice {
        SeatLeft from Server to Person cause l status 200;
      } or {
        RequestRejected from Server to Person cause l status 200;
      }
      continue Open;
    } or {
      s: StartGame from Person to Server route "POST /api/start_game";
      choice {
        a: GameStarted from Server to Person cause s status 200 where a.requestId = s.requestId;
      } or {
        x: RequestRejected from Server to Person cause s status 200 where x.requestId = s.requestId;
        continue Open;
      }
    }
  }
}

/-- A person's move is a request in its own session. The server answers it, or refuses it:
not this person's turn, a stale move number, the seat's byo-yomi clock already run out. -/
protocol PlayMoveP (Person, Server) given sessionId gameId {
  m: PlayMove from Person to Server route "POST /api/play_move";
  choice {
    p: MovePlayed from Server to Person cause m status 200
       where p.requestId = m.requestId ∧ p.moveNo = m.moveNo;
  } or {
    x: RequestRejected from Server to Person cause m status 200 where x.requestId = m.requestId;
  }
}

/-- One bot search, bound to its turn revision. The result is applied only if the turn it was
dispatched for is still the current one; otherwise it is dropped. -/
protocol BotTurnP (Server, Bot) {
  t: BotTurn from Server to Bot;
  c: BotMoveChosen from Bot to Server cause t where c.turnSeq = t.turnSeq;
  choice {
    Applied at Server;
  } or {
    Stale at Server;
  }
}

/-- The server's side of one turn: a bot (or autopilot) plays it, the seat's byo-yomi clock ends it, or a
resigned seat passes. A person's own move ends it through PlayMoveP, in another session.
Everything here is recorded at the server; people see it through GameState. -/
protocol Turn (Server, Bot) {
  choice {
    include BotTurnP Server Bot;
  } or {
    ClockRanOut at Server;
  } or {
    Passed at Server;
  }
}

/-- Autopilot for one's own seat, a request in its own session. -/
protocol SetAutopilotP (Person, Server) given sessionId gameId {
  a: SetAutopilot from Person to Server route "POST /api/set_autopilot";
  choice {
    AutopilotSet from Server to Person cause a status 200;
  } or {
    RequestRejected from Server to Person cause a status 200;
  }
}

protocol ProposeMergeP (Person, Server) given sessionId gameId {
  q: ProposeMerge from Person to Server route "POST /api/propose_merge";
  choice {
    a: MergeProposed from Server to Person cause q status 200 where a.requestId = q.requestId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

/-- One answer to a proposal. The response says where the proposal stands: still pending,
merged (this was the last acceptance) or withdrawn (a decline, or a team changed). -/
protocol RespondMergeP (Person, Server) given sessionId gameId {
  q: RespondMerge from Person to Server route "POST /api/respond_merge";
  choice {
    a: MergeResponded from Server to Person cause q status 200
       where a.requestId = q.requestId ∧ a.proposalId = q.proposalId ∧
             (a.status = "pending" ∨ a.status = "merged" ∨ a.status = "withdrawn");
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

protocol GameStateP (Person, Server) given sessionId gameId {
  q: GetGameState from Person to Server route "POST /api/game_state";
  choice {
    a: GameState from Server to Person cause q status 200 where a.requestId = q.requestId;
  } or {
    x: RequestRejected from Server to Person cause q status 200 where x.requestId = q.requestId;
  }
}

/-- One game, a session of its own: its creator's CreateGame, answered by GameCreated, which mints the
game's id; then the challenge, run by the creator, and the server's turns until the game finishes.
A rejected CreateGame ends it. -/
protocol GameP (Person, Server, Bot) given sessionId {
  g: CreateGame from Person to Server route "POST /api/create_game";
  choice {
    c: GameCreated from Server to Person cause g status 200 where c.requestId = g.requestId;
    include Challenge Person Server with sessionId, gameId;
    loop Turns {
      choice {
        include Turn Server Bot;
        continue Turns;
      } or {
        Finished at Server;
      }
    }
  } or {
    x: RequestRejected from Server to Person cause g status 200 where x.requestId = g.requestId;
  }
}

/-- A person's place in a game they picked: taking a seat, then any number of independent requests,
each its own session given both the person's session and the game, so each belongs to both. -/
protocol SeatP (Person, Server) given sessionId gameId {
  include TakeSeatP Person Server with sessionId, gameId;
  parallel {
    sessions { include PlayMoveP Person Server with sessionId, gameId; }
  } and {
    sessions { include SetAutopilotP Person Server with sessionId, gameId; }
  } and {
    sessions {
      choice {
        include ProposeMergeP Person Server with sessionId, gameId;
      } or {
        include RespondMergeP Person Server with sessionId, gameId;
      }
    }
  } and {
    sessions { include GameStateP Person Server with sessionId, gameId; }
  }
}

/-- GoServer, one person's part of it. A person signs in, which mints the session every later request
carries (a refused sign-in, a wrong password, a claimed name or a throttled name, is retried); then
enters a room (a rejected entry is retried). Listing the room's games runs beside everything else, as the
browser polls it. In the room they create rooms and chat;
start a game, which runs as a session of its own beside the lobby; or pick a game (its id only a
reference) and take part in it, also beside the lobby; or sign out, which ends their session. -/
protocol GoServer (Person, Server, Bot) {
  loop SignIn {
    i: IssueSession from Person to Server route "POST /api/issue_session";
    choice {
      SessionIssued from Server to Person cause i status 200;
    } or {
      SignInRefused from Server to Person cause i status 401;
      continue SignIn;
    }
  }
  loop Enter {
    e: EnterRoom from Person to Server route "POST /api/enter_room";
    choice {
      a: RoomEntered from Server to Person cause e status 200
         where a.requestId = e.requestId ∧ a.roomId = e.roomId;
    } or {
      x: RequestRejected from Server to Person cause e status 200 where x.requestId = e.requestId;
      continue Enter;
    }
  }
  parallel {
    sessions { include ListGamesP Person Server with sessionId; }
  } and {
  loop Lobby {
    choice {
      include CreateRoomP Person Server with sessionId;
      continue Lobby;
    } or {
      include RoomChatP Person Server with sessionId;
      continue Lobby;
    } or {
      sessions { include GameP Person Server Bot with sessionId; }
      continue Lobby;
    } or {
      j: JoinGame from Person to Server route "POST /api/join_game";
      choice {
        GameJoined from Server to Person cause j status 200;
        sessions { include SeatP Person Server with sessionId, gameId; }
        continue Lobby;
      } or {
        RequestRejected from Server to Person cause j status 200;
        continue Lobby;
      }
    } or {
      o: SignOut from Person to Server route "POST /api/sign_out";
      SignedOut from Server to Person cause o status 200;
    }
  }
  }
}

requirements {
  "A person's part of GoServer follows GoServer" => GoServer;
  "A person enters a room only after signing in" => GoServer ⊨ (precedes (on SessionIssued) (on EnterRoom));
  "Nothing is asked of a room before it is entered" => GoServer ⊨ (precedes (on RoomEntered) (or (on ListGames) (or (on CreateRoom) (or (on SendRoomChat) (or (on CreateGame) (on JoinGame))))));
  "Every sign-in attempt is answered" => GoServer ⊨ (stronglyImplies (on IssueSession) (allUnless (not stop) (or (on SessionIssued) (on SignInRefused))));
  "A refused sign-in may be retried" => GoServer ⊨ (possibly (and (on SignInRefused) (someNext (on IssueSession))));
  "A signed-in person does not sign in again in that session" => GoServer ⊨ (stronglyImplies (on SessionIssued) (allNext (never (on IssueSession))));
  "Every request in the room is answered or refused" => GoServer ⊨ (and (stronglyImplies (on EnterRoom) (allUnless (not stop) (or (on RoomEntered) (on RequestRejected)))) (and (stronglyImplies (on CreateRoom) (allUnless (not stop) (or (on RoomCreated) (on RequestRejected)))) (and (stronglyImplies (on SendRoomChat) (allUnless (not stop) (or (on RoomChat) (on RequestRejected)))) (and (stronglyImplies (on ListGames) (allUnless (not stop) (or (on GamesListed) (on RequestRejected)))) (and (stronglyImplies (on JoinGame) (allUnless (not stop) (or (on GameJoined) (on RequestRejected)))) (stronglyImplies (on CreateGame) (allUnless (not stop) (or (on GameCreated) (on RequestRejected)))))))));
  "A person moves only in a game they joined" => GoServer ⊨ (precedes (on GameJoined) (on PlayMove));
  "After signing out a person asks nothing more of a room or a game" => GoServer ⊨ (stronglyImplies (on SignedOut) (never (or (on CreateRoom) (or (on SendRoomChat) (or (on CreateGame) (or (on JoinGame) (on PlayMove)))))));
  "A game follows GameP" => GameP;
  "A game starts only after it is created" => GameP ⊨ (precedes (on GameCreated) (on GameStarted));
  "A created game starts before its session can end" => GameP ⊨ (stronglyImplies (on GameCreated) (allUnless (not stop) (on GameStarted)));
  "No turn is played before the start" => GameP ⊨ (precedes (on GameStarted) (or (on BotTurn) (or (on ClockRanOut) (on Passed))));
  "Seats and the seat plan change only before the start" => GameP ⊨ (stronglyImplies (on GameStarted) (never (or (on TakeSeat) (or (on LeaveSeat) (on SetSeatPlan)))));
  "Games always finish" => GameP ⊨ (stronglyImplies (on GameStarted) (allUnless (not stop) (on Finished)));
  "A finished game has no more turns" => GameP ⊨ (stronglyImplies (on Finished) (allNext (never (or (on BotTurn) (or (on ClockRanOut) (on Passed))))));
  "The challenge can end only with the game started" => Challenge ⊨ (always (implies stop (on GameStarted)));
  "A refused request leaves the challenge open" => Challenge ⊨ (possibly (and (on RequestRejected) (possibly (on GameStarted))));
  "Turns always end" => Turn ⊨ (inevitably (or (on Applied) (or (on Stale) (or (on ClockRanOut) (on Passed)))));
  "Every bot search is answered" => BotTurnP ⊨ (stronglyImplies (on BotTurn) (inevitably (on BotMoveChosen)));
  "A bot result is applied or dropped as stale" => BotTurnP ⊨ (inevitably (or (on Applied) (on Stale)));
  "A late bot result may be dropped" => BotTurnP ⊨ (possibly (on Stale));
  "A seat is asked for before any play" => SeatP ⊨ (precedes (on TakeSeat) (or (on PlayMove) (or (on SetAutopilot) (or (on ProposeMerge) (on RespondMerge)))));
  "Every request about a game is answered or refused" => SeatP ⊨ (and (stronglyImplies (on PlayMove) (allUnless (not stop) (or (on MovePlayed) (on RequestRejected)))) (and (stronglyImplies (on SetAutopilot) (allUnless (not stop) (or (on AutopilotSet) (on RequestRejected)))) (and (stronglyImplies (on ProposeMerge) (allUnless (not stop) (or (on MergeProposed) (on RequestRejected)))) (and (stronglyImplies (on RespondMerge) (allUnless (not stop) (or (on MergeResponded) (on RequestRejected)))) (stronglyImplies (on GetGameState) (allUnless (not stop) (or (on GameState) (on RequestRejected))))))));
  "A move is played or refused" => PlayMoveP ⊨ (stronglyImplies (on PlayMove) (inevitably (or (on MovePlayed) (on RequestRejected))));
  -- intended: Turn ⊨ (always (implies <turn ends> (allNext (never <turn ends>)))); the checker repeats the last
  -- event of a finished conversation (counterexample ClockRanOut -> ClockRanOut), so this waits for a stop-aware next
  "A turn never ends twice" => sorry;
  -- data: seat, turn and move number
  "A person moves only for their own seat, in turn, with the current move number" => sorry;
  -- data: turnSeq against the current turn revision
  "A bot result changes the game only for the turn it was dispatched for" => sorry;
  -- data: clock values
  "Byo-yomi clocks never give a seat time back" => sorry;
  -- data: acceptances per seated person
  "Teams merge only with the consent of every person seated in both" => sorry;
  -- data: passwords and claims
  "A claimed name never gets a session without its password" => sorry;
  -- data: requestId equality (the where clauses)
  "Every answer carries its request's id" => sorry;
  -- needs a server crash: intended (stronglyImplies (on SessionIssued) ...) over a restart path
  "Claims and rated results survive a restart" => sorry;
  -- needs message loss: the room and game answer entries with loss allowed
  "Every request is answered or refused when a connection drops" => sorry;
}
