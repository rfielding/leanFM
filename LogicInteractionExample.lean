import LeanFM.Artifacts
import LeanFM.MDPDiagram
import LeanFM.LLMGenerated.SelfHosting
import LeanFM.Logic

namespace LogicInteractionExample
open LeanFM
open LeanFM.LLMGenerated.SelfHosting

/-- Flatten the accepted grammar; choice branches are labelled rather than drawn as frames. -/
partial def flatten (lead : String) : GrammarExpr → List MDPDiagram.InteractionMessage
  | .event atom =>
      let fields := (logicMessages.find? (·.name == atom.message)).map (fun m => m.fields.map (·.name)) |>.getD []
      [{ src := atom.src, dst := atom.dst, label := lead ++ atom.message ++ "(" ++ ", ".intercalate (fields.map fun f => f.replace "_" "\\_") ++ ")" }]
  | .seq l r => flatten lead l ++ flatten lead r
  | .choice bs => (bs.zipIdx).flatMap fun (b, i) => flatten ("alt " ++ toString (i + 1) ++ ": ") b
  | _ => []

def provenance : DesiredOutput :=
  { id := "selfhost.mcp.logic.interaction"
  , prompt := "Expose the modal logic to MCP so an agent can consult it to create logic, events and observability correctly."
  , question := "How does an agent consult LeanFM about a formula, trace or requirement without executing code or changing acceptance?"
  , kind := .interactionDiagram
  , eventSource := "LeanFM.LLMGenerated.SelfHosting.logicGrammar"
  , reducer := "flatten seq and label each choice branch onto Agent and LeanFMServer lifelines"
  , unit := "JSON-RPC messages per stateless consultation" }

open Lean in
/-- Real tool output, minus the bounds block, for the book. -/
def answer (tool args : String) : String :=
  let json := match Json.parse args with
    | .ok a => match LeanFM.Logic.run tool a with
      | some (.ok j) => j
      | some (.error r) => Json.mkObj [("verdict", "rejected"), ("reason", r)]
      | none => Json.null
    | .error e => Json.str e
  let hidden := ["bounds", "terminalConvention", "sequenceDiagram", "causalGraph"]
  let trimmed := match json with
    | .obj kvs => Json.mkObj (kvs.toList.filter fun (k, _) => !hidden.contains k)
    | j => j
  let diagram := match (json.getObjVal? "sequenceDiagram").toOption.bind (·.getStr?.toOption) with
    | some text => "\n\\end{lstlisting}\n\\noindent with the generated Mermaid sequence diagram\n\\begin{lstlisting}[language={},breaklines=true]\n" ++ text
    | none => ""
  trimmed.pretty 72 ++ diagram

def listing (caption request response : String) : String :=
  "\\medskip\\noindent\\textbf{" ++ caption ++ "}\\par\\nopagebreak\n\\begin{lstlisting}[language={},breaklines=true]\n" ++ request ++
  "\n\\end{lstlisting}\n\\noindent returns\n\\begin{lstlisting}[language={},breaklines=true]\n" ++ response ++ "\n\\end{lstlisting}\n\n"

def examples : List (String × String × String) :=
  [ ("A never-claim that fails", "check_ctl",
     "{\"task\": \"mcp_logic_consult\", \"formula\": {\"never\": {\"after\": \"LogicInputRejected\"}}}")
  , ("A requirement over hidden state", "classify_requirement",
     "{\"predicates\": [\"the cache is consistent\"], \"task\": \"mcp_logic_consult\"}")
  , ("Designing a sequence diagram by writing events", "check_trace",
     "{\"events\": [{\"id\": \"e1\", \"task\": \"mcp_logic_consult\", \"src\": \"Agent\", \"dst\": \"LeanFMServer\", \"message\": \"LogicConsultRequested\"}, {\"id\": \"e2\", \"prevIds\": [\"e1\"], \"causeIds\": [\"e1\"], \"task\": \"mcp_logic_consult\", \"src\": \"LeanFMServer\", \"dst\": \"Agent\", \"message\": \"LogicVerdict\"}]}") ]

def main : IO Unit := do
  IO.FS.writeFile "book/generated/mcp-logic-examples.tex" <|
    "% Generated by LogicInteractionExample.lean from LeanFM.Logic.run; do not edit.\n" ++
    String.join (examples.map fun (caption, tool, args) =>
      listing (caption ++ " (\\texttt{" ++ tool.replace "_" "\\_" ++ "})") (match Lean.Json.parse args with | .ok j => j.pretty 72 | .error _ => args) (answer tool args))
  IO.FS.writeFile "book/generated/mcp-logic-interaction.tex"
    (MDPDiagram.renderInteractionTeX ["Agent", "LeanFMServer"] (flatten "" logicGrammar.body))
  IO.FS.writeFile "book/generated/mcp-logic-interaction-provenance.txt" (reprStr provenance ++ "\n")
  IO.println "ok: MCP logic interaction diagram generated"
end LogicInteractionExample

def main : IO Unit := LogicInteractionExample.main
