import LeanFM.Artifacts
import LeanFM.MDPDiagram
import LeanFM.Logic
import LeanFM.Overlay

/-! Generates the book's "Generated examples" chapter figures and answers from
    one bounded-retry task and one declared overlay. Nothing here is drawn by
    hand: every run, number and diagram is computed by LeanFM.Logic and
    LeanFM.Overlay. -/

namespace ProbabilityOverlayExample
open LeanFM
open LeanFM.Logic
open LeanFM.Overlay

def tr (src dst message sender receiver : String) : Transition :=
  { src, dst, message, sender := some sender, receiver := some receiver }

/-- The core: what can happen. No probabilities, no times. -/
def task : TaskModel :=
  { id := "bounded_retry", canonical := false, initial := "idle"
  , states := ["idle", "waiting1", "backoff1", "waiting2", "backoff2", "waiting3", "done", "gave_up"]
  , terminals := ["done", "gave_up"]
  , transitions :=
      [ tr "idle" "waiting1" "Request" "Client" "Server"
      , tr "waiting1" "done" "Response" "Server" "Client"
      , tr "waiting1" "backoff1" "Timeout" "Timer" "Client"
      , tr "backoff1" "waiting2" "Request" "Client" "Server"
      , tr "waiting2" "done" "Response" "Server" "Client"
      , tr "waiting2" "backoff2" "Timeout" "Timer" "Client"
      , tr "backoff2" "waiting3" "Request" "Client" "Server"
      , tr "waiting3" "done" "Response" "Server" "Client"
      , tr "waiting3" "gave_up" "Timeout" "Timer" "Client" ] }

def ann (src message : String) (num den delay : Nat) : Annotation :=
  { src, message, probability := Q.norm num den, delayMs := delay }

/-- A separate, declared overlay: what we expect, not what was measured. -/
def declared : Overlay :=
  { name := "declared-v1", kind := "declared"
  , annotations :=
      [ ann "idle" "Request" 1 1 5
      , ann "waiting1" "Response" 9 10 40, ann "waiting1" "Timeout" 1 10 200
      , ann "backoff1" "Request" 1 1 5
      , ann "waiting2" "Response" 9 10 40, ann "waiting2" "Timeout" 1 10 200
      , ann "backoff2" "Request" 1 1 5
      , ann "waiting3" "Response" 9 10 40, ann "waiting3" "Timeout" 1 10 200 ] }

def isDone (s : String) : Bool := s == "done"
def isGaveUp (s : String) : Bool := s == "gave_up"

def esc (s : String) : String := s.replace "_" "\\_"

/-- A generated run as an interaction diagram, labelled with delivery time and branch probability. -/
def runDiagram (r : Run) : String :=
  MDPDiagram.renderInteractionTeX ["Client", "Server", "Timer"] <| r.steps.map fun s =>
    { src := s.transition.sender.getD "?", dst := s.transition.receiver.getD "?"
    , label := "t=" ++ toString s.atMs ++ "ms " ++ s.transition.message ++
        (if s.probability == Q.one then "" else " (p=" ++ s.probability.text ++ ")") }

/-- The task's state machine with the overlay drawn on its edges. -/
def stateMachine : String :=
  let pos : String → String
    | "idle" => "(0,0)" | "waiting1" => "(0,-1.7)" | "backoff1" => "(0,-3.4)" | "waiting2" => "(0,-5.1)"
    | "backoff2" => "(0,-6.8)" | "waiting3" => "(0,-8.5)" | "gave_up" => "(0,-10.2)" | _ => "(6,-5.1)"
  let label (t : Transition) : String :=
    match annotationFor declared t with
    | some a => t.message ++ "\\\\ " ++ (if a.probability == Q.one then "" else "p=" ++ a.probability.text ++ ", ") ++ toString a.delayMs ++ "ms"
    | none => t.message
  let bend (t : Transition) : String :=
    if t.dst == "done" then (if t.src == "waiting2" then "" else if t.src == "waiting1" then "bend left=10" else "bend right=10") else ""
  "% Generated by ProbabilityOverlayExample.lean from LeanFM.Overlay.declared.\n" ++
  "\\begin{tikzpicture}[>=Stealth,state/.style={draw=diagramink,text=diagramink,fill=diagramsurface,rounded corners,minimum width=1.7cm,minimum height=7mm,font=\\small},edge/.style={->,draw=leanblue,thick},lbl/.style={font=\\scriptsize,text=diagramink,align=center,fill=pagebackground,inner sep=1pt}]\n" ++
  String.join (task.states.map fun s =>
    "\\node[state" ++ (if task.terminals.contains s then ",double" else "") ++ "] (" ++ s.replace "_" "" ++ ") at " ++ pos s ++ " {" ++ esc s ++ "};\n") ++
  String.join (task.transitions.map fun t =>
    "\\draw[edge] (" ++ t.src.replace "_" "" ++ ") to[" ++ bend t ++ "] node[lbl" ++ (if t.dst == "done" then "" else ",left=3pt") ++ "] {" ++ label t ++ "} (" ++ t.dst.replace "_" "" ++ ");\n") ++
  "\\end{tikzpicture}\n"

def distributionChart (points : List (Nat × Q)) : String :=
  "% Generated by ProbabilityOverlayExample.lean: completion-time distribution of runs ending in done.\n" ++
  "\\begin{tikzpicture}\n\\begin{axis}[ybar,ymode=log,log origin=infty,width=.92\\linewidth,height=5.2cm,bar width=16pt," ++
  "xlabel={completion time (ms)},ylabel={probability},symbolic x coords={" ++
  ",".intercalate (points.map (fun p => toString p.1)) ++ "},xtick=data," ++
  "nodes near coords,nodes near coords style={font=\\scriptsize},point meta=explicit symbolic," ++
  "ymin=0.0005,ymax=3,enlarge x limits=0.18]\n" ++
  "\\addplot[fill=leanblue,draw=leanblue] coordinates {" ++
  String.join (points.map fun (t, q) => "(" ++ toString t ++ "," ++ q.decimal 6 ++ ") [" ++ q.text ++ "]") ++ "};\n" ++
  "\\end{axis}\n\\end{tikzpicture}\n"

def row (question formula answer : String) : String :=
  question ++ " & \\texttt{" ++ formula ++ "} & " ++ answer ++ " \\\\\n"

def main : IO Unit := do
  let rs ← match runs task declared with
    | .ok rs => pure rs
    | .error e => throw (IO.userError e)
  -- The core verdict needs no overlay.
  let some model := buildModel task | throw (IO.userError "model exceeded bounds")
  let ends := Model.get (Model.sat model (.af .terminal)) 0
  let reachDone := probabilityReaching rs isDone
  let within300 := probabilityWithin rs isDone 300
  let slo99 := Q.le (Q.norm 99 100) within300
  let slo999 := Q.le (Q.norm 999 1000) within300
  let canGiveUp := Model.get (Model.sat model (.ef (.atState "gave_up"))) 0
  let some giveUp := mostLikely rs (fun r => isGaveUp r.final) | throw (IO.userError "no give-up run")
  let some late := mostLikely rs (fun r => !(r.steps.any fun s => isDone s.transition.dst && s.atMs ≤ 300))
    | throw (IO.userError "no late run")
  let some usual := mostLikely rs (fun _ => true) | throw (IO.userError "no runs")
  let points := completionTimes rs isDone
  let verdict (b : Bool) := if b then "proved" else "disproved"
  IO.FS.writeFile "book/generated/overlay-state-machine.tex" stateMachine
  IO.FS.writeFile "book/generated/overlay-run-usual.tex" (runDiagram usual)
  IO.FS.writeFile "book/generated/overlay-run-giveup.tex" (runDiagram giveUp)
  IO.FS.writeFile "book/generated/overlay-run-late.tex" (runDiagram late)
  IO.FS.writeFile "book/generated/overlay-distribution.tex" (distributionChart points)
  IO.FS.writeFile "book/generated/overlay-answers.tex" <|
    "% Generated by ProbabilityOverlayExample.lean.\n" ++
    row "Does every run end? (core, no overlay)" "AF terminal" (verdict ends) ++
    row "Can the client give up?" "EF gave\\_up" (verdict canGiveUp ++ "; most likely witness has p=" ++ giveUp.probability.text ++ ", " ++ toString giveUp.durationMs ++ " ms") ++
    row "How likely is success?" "P=? [F done]" (reachDone.text ++ " (" ++ reachDone.decimal 3 ++ ")") ++
    row "Do 99\\% succeed within 300 ms?" "P>=99/100 [F<=300ms done]" (verdict slo99 ++ "; exactly " ++ within300.text) ++
    row "Do 99.9\\% succeed within 300 ms?" "P>=999/1000 [F<=300ms done]" (verdict slo999 ++ "; most likely late run p=" ++ late.probability.text ++ ", " ++ toString late.durationMs ++ " ms") ++
    row "Expected duration of a run" "E[duration]" ((expectedDuration rs).decimal 2 ++ " ms")
  IO.FS.writeFile "book/generated/overlay-provenance.txt" <|
    "task: bounded_retry (ProbabilityOverlayExample.task)\n" ++
    "overlay: " ++ declared.name ++ " (" ++ declared.kind ++ ")\n" ++
    "runs: " ++ toString rs.length ++ " complete runs enumerated exactly; probabilities are exact fractions\n" ++
    "reducers: LeanFM.Overlay.runs, probabilityReaching, probabilityWithin, mostLikely, completionTimes, expectedDuration\n" ++
    "core verdict: LeanFM.Logic.Model.sat (AF terminal) without the overlay\n"
  IO.println s!"ok: {rs.length} generated runs; P(F done)={reachDone.text}; P(F<=300ms done)={within300.text}"

end ProbabilityOverlayExample

def main : IO Unit := ProbabilityOverlayExample.main
